---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteNav from "@/components/SiteNav.astro";
import actionData from "@/generated/actions.json";

export async function getStaticPaths() {
  return actionData.actions.map((entry) => ({
    params: { plugin: entry.pluginID, provider: entry.providerID, action: entry.action.id }, props: { entry },
  }));
}

const { entry } = Astro.props as { entry: typeof actionData.actions[number] };
const localized = (value: Record<string, string>) => value["zh-Hans"] ?? value.en ?? "";
---

<BaseLayout title={`${entry.action.title.en ?? entry.action.id} · MacTools`} description={entry.action.description.en ?? ""} page="plugins">
  <SiteNav />
  <main class="plugin-detail-page">
    <section class="plugin-detail-hero plugin-action-hero" aria-labelledby="action-title">
      <a class="plugin-back-link" href={`/plugins/${entry.pluginID}`}>← Back to plugin</a>
      <p class="plugin-detail-eyebrow">{entry.pluginID} · {entry.providerID}</p>
      <h1 id="action-title">{localized(entry.action.title)}</h1>
      <p class="plugin-detail-lead">{localized(entry.action.description)}</p>
      <div class="plugin-detail-actions">
        <a class="button primary" href={entry.openInMacToolsURL}>Open in MacTools</a>
      </div>
      <div class="plugin-deep-link">
        <span class="plugin-deep-link-label">Navigation-only action highlight</span>
        <a href={entry.openInMacToolsURL}><code>{entry.openInMacToolsURL}</code></a>
      </div>
    </section>
    <section class="plugin-detail-section">
      <h2>Action details</h2>
      <p class="plugin-detail-muted">{[entry.action.risk, ...entry.action.surfaces, ...entry.action.permissionIDs].filter(Boolean).join(" · ") || "No additional details listed."}</p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
