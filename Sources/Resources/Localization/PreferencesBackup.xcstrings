    "preferencesBackup.preview.replaceNotice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستبدل الفئات المعروضة من التفضيلات؛ وتعود الإعدادات غير الموجودة في النسخة الاحتياطية إلى قيمها الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angezeigten Einstellungskategorien werden ersetzt; Einstellungen, die nicht in der Sicherung enthalten sind, werden auf ihre Standardwerte zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The listed preference categories are replaced; settings absent from the backup return to their defaults."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazan las categorías de preferencias indicadas; los ajustes que no están en la copia vuelven a sus valores predeterminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories de préférences indiquées sont remplacées ; les réglages absents de la sauvegarde reviennent à leurs valeurs par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示された環境設定のカテゴリが置き換えられます。バックアップにない設定はデフォルト値に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 환경설정 범주가 대체되며 백업에 없는 설정은 기본값으로 돌아갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias de preferências listadas são substituídas; as configurações ausentes do backup voltam aos valores padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перечисленные категории настроек заменяются; параметры, отсутствующие в резервной копии, возвращаются к значениям по умолчанию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将替换以上偏好类别；备份中未包含的设置会恢复为默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將取代以上偏好類別；備份中未包含的設定會回復為預設值。"
          }
        }
      }
    }
