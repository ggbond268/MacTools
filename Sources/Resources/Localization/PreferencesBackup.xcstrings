          }
        }
      }
    },
    "preferencesBackup.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدير واستيراد التفضيلات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen exportieren und importieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export and Import Preferences"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar e importar preferencias"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter et importer les préférences"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境設定をエクスポート／インポート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경설정 내보내기 및 가져오기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar e importar preferências"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт и импорт настроек"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出与导入偏好设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出與匯入偏好設定"
          }
        }
      }
    },
    "preferencesBackup.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن تفضيلات التطبيق وترتيب عرض الإضافات واختصارات لوحة المفاتيح؛ ولا يتضمن الأذونات أو ذاكرة التخزين المؤقت أو بيانات الإضافات الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält App-Einstellungen, Plugin-Anzeigereihenfolge und Tastaturkurzbefehle; Berechtigungen, Caches und private Plug-in-Daten sind ausgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes app preferences, plugin display order, and keyboard shortcuts; permissions, caches, and plugin-private data are excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye preferencias de la app, orden de visualización de plugins y atajos de teclado; no incluye permisos, cachés ni datos privados de plugins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut les préférences de l’app, l’ordre d’affichage des extensions et les raccourcis clavier ; les autorisations, caches et données privées d’extension sont exclus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの環境設定、プラグインの表示順、キーボードショートカットを含みます。権限、キャッシュ、プラグイン固有のデータは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 환경설정, 플러그인 표시 순서, 키보드 단축키를 포함합니다. 권한, 캐시, 플러그인 전용 데이터는 제외됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui preferências do app, ordem de exibição dos plugins e atalhos de teclado; permissões, caches e dados privados de plugins são excluídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает настройки приложения, порядок отображения плагинов и сочетания клавиш; разрешения, кэш и приватные данные плагинов исключены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含应用偏好、插件显示顺序与快捷键；不会包含权限、缓存或插件私有数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含應用程式偏好、插件顯示順序與快速鍵；不會包含權限、快取或插件私有資料。"
          }
        }
      }
    },
