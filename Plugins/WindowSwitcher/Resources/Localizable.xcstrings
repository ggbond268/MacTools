    "settings.status.enabled.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الاختصار لإظهار نوافذ التطبيق وتبديلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Verknüpfung, um App-Fenster anzuzeigen und zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el acceso directo para mostrar y cambiar las ventanas de aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le raccourci pour afficher et changer de fenêtre d'application."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로가기를 사용하여 앱 창을 표시하고 전환하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o atalho para mostrar e alternar janelas de aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте ярлык для отображения и переключения окон приложений."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the shortcut to show and switch app windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットでアプリのウインドウを表示・切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管切换快捷键，显示并切换应用窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接管切換快速鍵，顯示並切換 App 視窗。"
          }
        }
      }
    },
    "settings.status.disabled.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإيقاف مراقبة الاختصارات مؤقتًا واحتفظ بمبدل نافذة النظام دون تغيير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterbrechen Sie die Verknüpfungsüberwachung und lassen Sie den Systemfenster-Umschalter unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar la supervisión de accesos directos y mantener el selector de ventanas del sistema sin cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendez la surveillance des raccourcis et conservez le sélecteur de fenêtre système inchangé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로가기 모니터링을 일시 중지하고 시스템 창 전환기를 변경하지 않은 상태로 유지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause o monitoramento de atalhos e mantenha o alternador de janelas do sistema inalterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановите мониторинг ярлыков и оставьте переключатель системных окон без изменений."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause shortcut monitoring and keep the system window switcher unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットの監視を停止し、システム標準の切り替えをそのまま使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停快捷键监听，系统默认切换保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停快速鍵監聽，維持系統預設的切換方式。"
          }
        }
      }
    },
