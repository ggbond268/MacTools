    "settings.sort.fixed.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب التطبيقات باستمرار بالاسم حتى يسهل تذكر مواقعها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnen Sie Apps konsequent nach Namen, damit Sie sich ihre Positionen leichter merken können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene las aplicaciones constantemente por nombre para que sus posiciones sean más fáciles de recordar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classez les applications de manière cohérente par nom afin que leurs positions soient plus faciles à mémoriser."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 위치를 더 쉽게 기억할 수 있도록 이름별로 일관되게 앱을 주문하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene os aplicativos de forma consistente por nome para que suas posições sejam mais fáceis de lembrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядочивайте приложения по именам, чтобы их расположение было легче запомнить."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order apps consistently by name so their positions are easier to remember."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ名で常に同じ順序に並べ、位置を覚えやすくします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按应用名称稳定排列，位置更容易记住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依 App 名稱固定排列，位置更容易記住。"
          }
        }
      }
    },
    "error.accessibilityRevoked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف تشغيل الوصول إلى إمكانية الوصول، لذا تم إيقاف Window Switcher مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der barrierefreie Zugriff wurde deaktiviert, daher ist Window Switcher angehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de accesibilidad se desactivó, por lo que Window Switcher está en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à l'accessibilité a été désactivé, donc Window Switcher est mis en pause."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성 액세스가 사용 중지되어 창 전환기가 일시중지되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso de acessibilidade foi desativado, então o Window Switcher está pausado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к специальным возможностям был отключен, поэтому переключение окон приостановлено."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access was turned off, so Window Switcher is paused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティのアクセスが無効になったため、ウインドウ切り替えを一時停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限已关闭，窗口切换已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用權限已關閉，視窗切換已暫停。"
          }
        }
      }
    },
    "error.accessibilityRequired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Window Switcher إلى الوصول إلى إمكانية الوصول. افتح الإعدادات للسماح بذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switcher benötigt Zugriff auf Barrierefreiheit. Öffnen Sie die Einstellungen, um dies zuzulassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switcher necesita acceso de accesibilidad. Abra Configuración para permitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switcher a besoin d’un accès d’accessibilité. Ouvrez Paramètres pour l'autoriser."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 전환기에는 접근성 액세스 권한이 필요합니다. 설정을 열어 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Window Switcher precisa de acesso de acessibilidade. Abra Configurações para permitir isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для переключателя окон требуется доступ к специальным возможностям. Откройте «Настройки», чтобы разрешить это."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switcher needs Accessibility access. Open Settings to allow it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替えにはアクセシビリティのアクセスが必要です。設定で許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口切换需要辅助功能权限，请先前往设置完成授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗切換需要輔助使用權限，請先前往設定完成授權。"
          }
        }
      }
    },
