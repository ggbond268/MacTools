    "settings.sort.recentUse.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بترتيب التطبيقات حسب الاستخدام الأخير حتى تتمكن من العودة بسرعة إلى النافذة السابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnen Sie Apps nach aktueller Nutzung, damit Sie schnell zum vorherigen Fenster zurückkehren können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene las aplicaciones por uso reciente para poder regresar rápidamente a la ventana anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classez les applications par utilisation récente afin de pouvoir revenir rapidement à la fenêtre précédente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 사용순으로 앱을 정렬하면 이전 창으로 빠르게 돌아갈 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene os aplicativos por uso recente para poder retornar rapidamente à janela anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядочивайте приложения по последнему использованию, чтобы можно было быстро вернуться к предыдущему окну."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort by window recency to return to the previous window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使用したアプリ順に並べ、直前のウインドウへすばやく戻れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按窗口最近使用时间排列，便于回到上一个窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依最近使用的 App 排列，方便快速回到上一個視窗。"
          }
        }
      }
    },
