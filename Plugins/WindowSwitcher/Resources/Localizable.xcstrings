    "settings.mode.keyWindow.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بعرض قائمة النوافذ الثابتة واضغط على الحرف الموجود أعلى الإدخال للتبديل إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie eine feste Fensterliste an und drücken Sie den Buchstaben über einem Eintrag, um zu diesem zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestre una lista de ventanas fijas y presione la letra que se encuentra encima de una entrada para cambiar a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez une liste de fenêtres fixe et appuyez sur la lettre au-dessus d'une entrée pour y accéder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정 창 목록을 표시하고 해당 항목 위의 문자를 누르면 해당 항목으로 전환됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre uma lista de janelas fixas e pressione a letra acima de uma entrada para alternar para ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отобразите фиксированный список окон и нажмите букву над записью, чтобы переключиться на него."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a searchable window list and press Return to switch. Old per-window letter assignments are retired; saved records are retained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定されたウインドウ一覧を表示し、項目の上の文字キーを押して直接切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示可搜索的窗口列表，按回车打开。旧窗口字母分配已停用，保留存储记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示固定視窗，按項目上方的字母直接切換。"
          }
        }
      }
    },
