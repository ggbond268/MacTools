    "note.appleDataRetained": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Related data for this Apple app will be kept."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此 Apple 应用的关联数据将保留。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此 Apple App 的相關資料將保留。"}}}},
    "candidate.keptUnmeasured": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Kept · size not measured"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留 · 未统计大小"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"保留 · 未統計大小"}}}},
    "xcode.scopeTitle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This copy and shared data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此版本与共享数据"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此版本與共用資料"}}}},
    "xcode.thisCopy": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This Xcode app bundle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此 Xcode 应用本体"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此 Xcode App 本體"}}}},
    "xcode.noExclusiveData": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No external data is confirmed exclusive to this copy. Its app bundle can be removed only after safety checks pass."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未确认任何独属于此副本的外部数据；应用本体通过检查后才可移除。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未確認任何只屬於此副本的外部資料；App 本體通過檢查後才能移除。"}}}},
    "xcode.exclusiveTitle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Data verified exclusive to this copy (%d)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已验证为此副本独有的数据（%d）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已驗證只屬於此副本的資料（%d）"}}}},
    "xcode.sharedTitle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shared or uncertain matches (%d)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"共享或归属不明的匹配项（%d）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"共用或歸屬不明的相符項目（%d）"}}}},
    "xcode.sharedExplanation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"These same-identifier items stay in place. Existing build data, archives, and simulators are not considered exclusive to this copy either."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下列同标识符数据会保留；现有构建数据、归档和模拟器也不能认定为此副本独有。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下列同識別碼資料會保留；現有建置資料、封存和模擬器也無法認定只屬於此副本。"}}}},
    "xcode.openStorage": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Review Xcode storage"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看 Xcode 存储"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看 Xcode 儲存空間"}}}},
    "xcode.storageWarningTitle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Shared Xcode storage"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"共享 Xcode 数据"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"共用 Xcode 資料"}}}},
    "xcode.storageWarning": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Xcode Cleanup is separate: selected files are permanently deleted and may also be used by regular Xcode."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Xcode 清理是独立操作；选中的文件会被永久删除，也可能被正式版 Xcode 使用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Xcode 清理是獨立操作；所選檔案會被永久刪除，也可能由正式版 Xcode 使用。"}}}},
    "inventory.includeApp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Add this app to the removal review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将此应用加入移除清单"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將此 App 加入移除清單"}}}},
    "app.details": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"App identity and removal limits"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用身份与处理限制"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"應用身分與處理限制"}}}},
    "app.needsOtherTool": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This app needs another removal method. See the reasons below."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此应用需要其他方式处理；请查看下方原因。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此 App 需要其他移除方式；請查看下方原因。"}}}},
    "batch.confirmScope": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Only listed items will move to Trash. Documents, projects, and other unchecked locations are outside this review. Moving to Trash does not immediately free space."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅列出的项目会移入废纸篓。文稿、项目和其他未检查位置不在此清单中；移入废纸篓不会立即释放空间。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"僅列出的項目會移至垃圾桶。文件、專案及其他未檢查位置不在此清單中；移至垃圾桶不會立即釋放空間。"}}}},
    "batch.confirmSummary": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%d items to move · %d kept · estimated size %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 项拟移入 · %d 项保留 · 估计占用 %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%d 個項目將移入 · %d 個保留 · 預估佔用 %@"}}}},
    "batch.confirmTitle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Review removal of %d apps"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认处理 %d 个应用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"確認處理 %d 個 App"}}}},
    "batch.itemCount": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%d items to move"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 项拟移入"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%d 個項目將移入"}}}},
    "batch.keptCount": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%d items kept"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 项保留"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%d 個項目保留"}}}},
    "batch.partialCoverage": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"One or more apps have unchecked locations. Only verified items will move."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"一个或多个应用存在未查全的位置；只会移除已验证项目。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一個或多個 App 有未完整檢查的位置；只會移除已驗證的項目。"}}}},
    "batch.processUnknown": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The running-process check is not complete. Removal is unavailable for now."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"运行进程检查尚未完成，暂不能移除。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"執行中程序的檢查尚未完成，目前無法移除。"}}}},
    "batch.removing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Processing app %d of %d…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在处理应用 %d/%d…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在處理 App %d/%d…"}}}},
    "batch.rescan": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Review selected apps again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查所选应用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新檢查所選 App"}}}},
    "batch.result": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Completed %d of %d apps. Review item-by-item results."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成 %d/%d 个应用。请查看逐项结果。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已完成 %d/%d 個 App。請查看逐項結果。"}}}},
    "batch.reviewHelp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Each app is checked and recorded separately. Expand an app to choose data to keep."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每个应用独立检查与记录。展开任一应用以选择要保留的关联数据。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每個 App 會分別檢查與記錄。展開 App 以選擇要保留的相關資料。"}}}},
    "batch.reviewRemoval": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Review removal…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查移除清单…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查移除清單…"}}}},
    "batch.reviewTitle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Review selected apps"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选应用的审阅结果"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"所選 App 的審閱結果"}}}},
    "batch.running": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A selected app or component is still running. Save your work and quit it before retrying."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选应用或组件仍在运行。请保存工作并退出后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"所選 App 或元件仍在執行。請儲存工作並結束後重試。"}}}},
