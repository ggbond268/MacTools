    "plan.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items move to Trash without permanent deletion. Putting an app back does not guarantee restoring all its state. Unselected items and uninspected locations stay in place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移入废纸篓，不会永久删除。放回应用不保证恢复所有状态。未选择的项目及未检查的位置会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移入废纸篓，不会永久删除。放回应用不保证恢复所有状态。未选择的项目及未检查的位置会保留。"
          }
        }
      }
    },
