    "review.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the listed user Library locations and available app metadata were checked. Documents, projects, and whole-disk leftovers are outside this review. No matches does not mean that an app has no other data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅检查列出的用户资料库位置及已读取的应用元数据。未搜索文稿、项目文件或全盘遗留文件；没有发现关联项不代表应用没有其他数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仅检查列出的用户资料库位置及已读取的应用元数据。未搜索文稿、项目文件或全盘遗留文件；没有发现关联项不代表应用没有其他数据。"
          }
        }
      }
    },
