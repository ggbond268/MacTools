        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認哪個應用程式擁有此容器。"
          }
        }
      }
    },
    "note.groupUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed app-group information could not be verified; this check is incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名中的共享组信息无法验证，此位置检查不完整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證簽章中的共享群組資訊；此位置檢查不完整。"
          }
        }
