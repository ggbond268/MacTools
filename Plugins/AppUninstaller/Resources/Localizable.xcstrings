        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置管理狀態阻止移除。"
          }
        }
      }
    },
    "note.managedUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device management status could not be confirmed. File review only."
