        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取關聯位置。"
          }
        }
      }
    },
    "note.managed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is managed, or its management state is unclear. Contact an administrator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备已注册管理或管理状态不明确，请联系管理员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置受管理，或管理狀態不明。請聯絡管理者。"
          }
        }
      }
    },
    "note.managedCoverage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device management status blocks removal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备管理状态阻止移除。"
