    "inventory.componentHelp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Embedded components should be managed through their parent app."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"嵌入式组件应由所属应用管理。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"內嵌元件應透過所屬 App 管理。"}}}},
    "inventory.components": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Standalone component entries"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"独立列出的组件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"單獨列出的元件"}}}},
    "inventory.empty": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No matching apps"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有匹配的应用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有符合的 App"}}}},
    "inventory.filter": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示"}}}},
    "inventory.intro": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Select one or more apps. Related data is checked only when you review your selection; nothing moves before confirmation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一个或多个应用。关联数据只在审阅所选应用时检查；确认之前不会移动任何内容。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇一個或多個 App。相關資料只會在檢查所選 App 時讀取；確認前不會移動任何內容。"}}}},
    "inventory.otherTool": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Other tool needed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需其他工具"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要其他工具"}}}},
    "inventory.partial": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Application inventory incomplete"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用列表未检查完整"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"App 清單未檢查完整"}}}},
    "inventory.partialHelp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can still browse available apps. Removal is blocked if the selected app's checks are incomplete."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分应用仍可浏览；所选应用的检查不完整时不会允许移除。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"仍可瀏覽已找到的 App；若所選 App 的檢查不完整，將無法移除。"}}}},
    "inventory.refresh": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh app list"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新应用列表"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新整理 App 清單"}}}},
    "inventory.reviewable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reviewable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可审阅"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可檢查"}}}},
    "inventory.scanning": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Finding applications…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在查找应用…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在搜尋 App…"}}}},
    "inventory.select": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Select app: "}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择应用："}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇 App："}}}},
    "inventory.selectDescription": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Search on the left, drag in an app, or choose one in Finder."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"左侧可搜索应用，也可拖入应用或从访达选择。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可在左側搜尋 App、拖入 App，或在 Finder 中選擇。"}}}},
    "inventory.selectPrompt": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an app to inspect"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择应用以查看详情"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇 App 以查看詳細資訊"}}}},
    "inventory.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Installed Applications"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装应用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已安裝的 App"}}}},
    "review.incomplete": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Checks or installation source are not confirmed. Removal is unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查或安装来源尚未确认；移除不可用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查或安裝來源尚未確認；無法移除。"}}}},
    "review.appOnly": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The app can be reviewed, but related data stays in place until the app inventory is complete."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用本体可审阅；应用列表未查全，关联数据将保留。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可檢查 App 本體；App 清單未查全，相關資料將保留。"}}}},
    "review.partialItems": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Some related locations could not be checked; only verified items can be moved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分关联位置未查全；只能移除已验证的项目。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"部分相關位置未查全；只能移除已驗證的項目。"}}}},
    "review.scopeShort": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Only listed related locations were checked. Documents, projects, and other locations were not searched."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只检查列出的关联位置；文稿、项目和其他位置未搜索。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只檢查列出的相關位置；文件、專案及其他位置未搜尋。"}}}},
