    "batch.selectFirst": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Select apps from the list first"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"先从列表中选择应用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請先從列表選擇 App"}}}},
    "batch.selectedApps": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%d apps selected"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已选择 %d 个应用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已選取 %d 個 App"}}}},
    "batch.source": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"I checked the installation sources of the apps above and confirmed that they do not require their original uninstallers."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我已检查上述安装来源未知的应用，并确认无需使用原安装工具。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"我已檢查上述安裝來源不明的 App，並確認不需使用原本的解除安裝工具。"}}}},
    "batch.viewResults": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"View results and recovery locations"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看结果与恢复位置"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看結果與還原位置"}}}},
    "error.moleIncompatible": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The embedded Mole engine returned an unsupported plan format."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内置 Mole 引擎返回了不支持的清单格式。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"內建 Mole 引擎傳回了不支援的清單格式。"}}}},
    "error.moleCleanupFailed": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The embedded Mole review stopped, but a helper process could not be cleaned up."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内置 Mole 检查已停止，但辅助进程未能完全清理。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"內建 Mole 檢查已停止，但輔助程序未能完全清理。"}}}},
    "error.moleOutputTooLarge": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The embedded Mole review returned too much data."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内置 Mole 检查返回的数据过多。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"內建 Mole 檢查傳回的資料過多。"}}}},
    "error.moleRejected": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The embedded Mole review could not be completed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内置 Mole 检查无法完成。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"內建 Mole 檢查無法完成。"}}}},
    "error.moleTimedOut": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The embedded Mole review timed out without changing files."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内置 Mole 检查超时，未更改任何文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"內建 Mole 檢查逾時，未變更任何檔案。"}}}},
    "error.removeNeedsAttention": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Removal was incomplete. Some items need manual attention; review the operation history."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除未完成；部分项目需要手动检查，请查看操作记录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"移除未完成；部分項目需要手動檢查，請查看操作記錄。"}}}},
    "error.removePartial": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Removal was incomplete. Review the item-by-item results."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除未完成；请查看逐项结果。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"移除未完成；請查看逐項結果。"}}}},
    "error.moleUnavailable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The embedded Mole engine is unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内置 Mole 引擎不可用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"內建 Mole 引擎無法使用。"}}}},
    "note.moleManualRequired": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This app requires manual removal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此应用需要手动处理。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此 App 需要手動處理。"}}}},
    "note.moleOutsideScope": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Mole found a review-only item outside the first-release removal scope."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Mole 发现首版移除范围以外的仅供检查项目。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mole 發現首版移除範圍以外、僅供檢查的項目。"}}}},
    "note.molePlanBlocked": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Mole could not safely prepare this app for removal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Mole 无法安全准备此应用的移除清单。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mole 無法安全準備此 App 的移除清單。"}}}},
    "note.moleReviewOnly": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Mole marked this item as review-only."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Mole 将此项目标记为仅供检查。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mole 將此項目標記為僅供檢查。"}}}},
    "note.moleSiblingGuard": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Another installed copy may share data; Mole narrowed the plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"另一个已安装副本可能共享数据；Mole 已缩小清单范围。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"另一個已安裝副本可能共用資料；Mole 已縮小清單範圍。"}}}},
    "note.moleSudoUnsupported": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This version supports only items that can move to Trash without administrator access."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此版本仅支持无需管理员权限的废纸篓移除。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此版本僅支援不需管理者權限的垃圾桶移除。"}}}},
    "note.moleSystemReviewOnly": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"System-level remnants are review-only and cannot be removed by this plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统级残留仅供检查，无法通过此清单移除。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"系統層級殘留僅供檢查，無法透過此清單移除。"}}}},
    "note.moleUnknownWarning": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Mole reported an unrecognized review warning. Only verified items are shown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Mole 报告一项未识别的检查警告；仅显示已验证项目。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mole 回報未識別的檢查警告；只會顯示已驗證的項目。"}}}},
    "note.moleVendorRequired": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the developer-provided uninstaller."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用开发者提供的卸载工具。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請使用開發者提供的解除安裝工具。"}}}},
