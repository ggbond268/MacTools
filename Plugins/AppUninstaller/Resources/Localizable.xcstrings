{
  "sourceLanguage": "en",
  "strings": {
    "error.historyRead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read operation history: "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取操作记录："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取操作紀錄："
          }
        }
      }
    },
    "error.quitIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has not quit. Save your work and quit it manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用尚未退出，请保存工作并手动退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式尚未結束。請儲存工作並手動結束。"
          }
        }
      }
    },
    "note.systemProtected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System applications are protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统应用受保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統應用程式受保護。"
          }
        }
      }
    },
    "note.selfProtected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools and its data are protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 及其数据受保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 及其資料受保護。"
          }
        }
      }
    },
    "note.embedded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage this embedded app through its parent app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入式应用应由所属应用管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內嵌應用程式應由所屬應用程式管理。"
          }
        }
      }
    },
    "note.outsideRoots": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is outside the usual installation folders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用位于常用安装目录之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式不在一般安裝資料夾中。"
          }
        }
      }
    },
    "note.privilegedHelper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app includes a privileged helper. Use the developer's uninstaller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含特权辅助工具，请使用开发者提供的卸载方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含特權輔助工具。請使用開發者提供的解除安裝方式。"
          }
        }
      }
    },
    "note.systemComponents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app includes system components. Use the developer's uninstaller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含系统组件，请使用开发者提供的卸载方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含系統元件。請使用開發者提供的解除安裝方式。"
          }
        }
      }
    },
    "note.componentCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check system components inside the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查应用内的系统组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查應用程式內的系統元件。"
          }
        }
      }
    },
    "note.receiptCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check the installation receipt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查安装收据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查安裝收據。"
          }
        }
      }
    },
    "note.embeddedCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The embedded-app check is incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入式应用检查不完整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內嵌應用程式檢查不完整。"
          }
        }
      }
    },
    "note.identityCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App identity could not be fully checked here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此位置未完成应用身份检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完整檢查此位置的應用程式身分。"
          }
        }
      }
    },
    "note.appDirectory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Applications folder could not be fully read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用目录无法完整读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完整讀取應用程式資料夾。"
          }
        }
      }
    },
    "note.runningIdentity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A running app's identity could not be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行中的应用身份无法读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取執行中應用程式的身分。"
          }
        }
      }
    },
    "note.vendorCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's built-in uninstall tools could not be fully checked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完整检查应用自带的卸载工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完整檢查應用程式內附的解除安裝工具。"
          }
        }
      }
    },
    "note.vendorFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A possible developer uninstaller was found. Review its instructions first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现可能的厂商卸载工具，请先检查其说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找到可能的開發者解除安裝工具。請先查看其說明。"
          }
        }
      }
    },
    "note.homebrew": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Managed by Homebrew. Uninstall it through the Homebrew plugin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Homebrew 管理，请前往 Homebrew 插件卸载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Homebrew 管理。請前往 Homebrew 外掛程式解除安裝。"
          }
        }
      }
    },
    "note.competing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another installed app uses the same identifier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个已安装的应用使用相同标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個已安裝的應用程式使用相同識別碼。"
          }
        }
      }
    },
    "note.inventoryIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed-app check is incomplete; ownership is still uncertain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装应用检查不完整，归属仍需核实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝應用程式檢查不完整；歸屬仍需確認。"
          }
        }
      }
    },
    "note.viewOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View only: exclusive ownership cannot be confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此位置仅供查看，无法确认独占归属。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供檢視：無法確認獨占歸屬。"
          }
        }
      }
    },
    "note.sizeIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The size or path check is incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小或路径检查不完整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大小或路徑檢查不完整。"
          }
        }
      }
    },
    "note.wrongType": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item type does not match this association rule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目类型与此关联规则不一致。"
