        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目類型與此關聯規則不符。"
          }
        }
      }
    },
    "note.containerMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Container metadata does not match the selected app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器元数据与所选应用不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "容器中繼資料與所選應用程式不符。"
          }
        }
      }
    },
    "note.containerUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify which app owns the container."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证容器的所属应用。"
