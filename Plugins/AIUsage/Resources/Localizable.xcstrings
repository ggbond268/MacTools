{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "access.allow": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取本机登录文件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read local login files"
          }
        }
      }
    },
    "access.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许读取 Codex 和 Claude Code 的本机登录文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to local Codex and Claude Code login files."
          }
        }
      }
    },
    "access.footer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅读取登录凭据并向对应服务查询额度，不读取对话、不保存令牌。授权与服务展示独立，无需辅助功能或完全磁盘访问权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only reads credentials to query the corresponding service. Conversations are never accessed and tokens are not stored. Access permissions are independent of service visibility. No Accessibility or Full Disk Access is needed."
          }
        }
      }
    },
    "keychain.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启时可能请求 macOS 授权，后台读取不会弹窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabling may request macOS authorization. Background reads never show prompts."
          }
        }
      }
    },
    "keychain.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 Claude Code 钥匙串"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Claude Code Keychain"
          }
        }
      }
    },
    "menuBar.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所有已启用服务的剩余额度。点击打开仪表盘，右键打开设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show remaining quota for every enabled service. Click for the dashboard; right-click for settings."
          }
        }
      }
    },
    "menuBar.show": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏显示用量"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show usage in menu bar"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Codex 与 Claude Code 订阅额度和重置时间"
