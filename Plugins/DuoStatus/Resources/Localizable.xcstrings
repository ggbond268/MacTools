{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate menu bar icon for battery and network status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立菜单栏图标，一眼查看电量与网络状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獨立選單列圖示，一眼查看電量與網路狀態"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立したメニューバーアイコンでバッテリーとネットワークの状態を確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도 메뉴 막대 아이콘에서 배터리와 네트워크 상태 확인"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Separates Menüleistensymbol für Batterie- und Netzwerkstatus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une icône distincte pour la batterie et le réseau dans la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un icono independiente para la batería y la red en la barra de menús."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ícone separado para bateria e rede na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельный значок строки меню для состояния батареи и сети."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيقونة مستقلة في شريط القوائم لحالة البطارية والشبكة."
          }
        }
      }
    },
    "metadata.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo Status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo 状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo 狀態"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo ステータス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo 상태"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo-Status"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État Duo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado Duo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado Duo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус Duo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة Duo"
          }
        }
      }
    },
    "settings.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arc shows battery charge; dots show Wi-Fi signal. Network status reflects the Mac’s connection, without testing internet access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆弧显示电量，圆点显示 Wi-Fi 信号。网络状态表示本机连接情况，不检测互联网是否可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓弧顯示電量，圓點顯示 Wi-Fi 訊號。網路狀態表示本機連線情況，不檢測網際網路是否可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円弧はバッテリー残量、点は Wi-Fi 信号を示します。ネットワーク状態は Mac の接続を示し、インターネットへのアクセスは確認しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호는 배터리 잔량, 점은 Wi-Fi 신호를 표시합니다. 네트워크 상태는 Mac의 연결 상태이며 인터넷 접속 여부는 확인하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bogen zeigt den Ladestand, Punkte das WLAN-Signal. Der Netzwerkstatus zeigt die Mac-Verbindung, ohne den Internetzugang zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arc indique la charge, les points le signal Wi-Fi. L’état du réseau reflète la connexion du Mac, sans tester l’accès à Internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El arco indica la batería y los puntos la señal Wi-Fi. El estado de red refleja la conexión del Mac, sin comprobar el acceso a internet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arco mostra a carga e os pontos o sinal Wi-Fi. O estado da rede reflete a conexão do Mac, sem testar o acesso à internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуга показывает заряд, точки — сигнал Wi-Fi. Состояние сети отражает подключение Mac без проверки доступа к интернету."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض القوس شحن البطارية والنقاط إشارة Wi-Fi. تعكس حالة الشبكة اتصال Mac دون اختبار الوصول إلى الإنترنت."
          }
        }
      }
    },
