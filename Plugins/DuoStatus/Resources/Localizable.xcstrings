    "settings.showDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover for status; click to open settings. Turning this off stops monitoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停查看状态，点击打开设置。关闭后停止监控。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫留查看狀態，點按開啟設定。關閉後停止監控。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを合わせて状態を確認し、クリックして設定を開きます。オフにすると監視を停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스를 올려 상태를 확인하고 클릭하여 설정을 엽니다. 끄면 모니터링이 중지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Status darüberfahren, für Einstellungen klicken. Ausschalten beendet die Überwachung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez pour voir l’état, cliquez pour ouvrir les réglages. La désactivation arrête la surveillance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el cursor para ver el estado; haz clic para abrir ajustes. Al desactivar, se detiene la supervisión."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o cursor para ver o estado; clique para abrir ajustes. Desativar interrompe o monitoramento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите указатель для просмотра состояния, нажмите для настроек. Отключение останавливает мониторинг."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر المؤشر لعرض الحالة وانقر لفتح الإعدادات. يؤدي الإيقاف إلى إيقاف المراقبة."
          }
        }
      }
    },
