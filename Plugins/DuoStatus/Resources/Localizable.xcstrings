    "settings.standaloneDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a separate icon. Hover for status; click to open settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立显示，悬停查看状态，点击打开设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獨立顯示，移至圖示查看狀態，點按開啟設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立したアイコンを表示します。ポインタを重ねると状態、クリックすると設定を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도 아이콘을 표시합니다. 마우스를 올리면 상태를 보고, 클릭하면 설정을 엽니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Separates Symbol anzeigen. Für Status darüberfahren, für Einstellungen klicken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une icône distincte. Survolez pour l’état, cliquez pour les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un icono independiente. Pasa el cursor para ver el estado; haz clic para abrir los ajustes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um ícone separado. Passe o cursor para ver o estado; clique para abrir as definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельный значок: наведите курсор для просмотра состояния, нажмите для настроек."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض أيقونة مستقلة. مرّر المؤشر لعرض الحالة وانقر لفتح الإعدادات."
          }
        }
      }
    },
    "settings.primaryDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the MacTools menu bar icon without changing its click behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换 MacTools 主图标，点击行为保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代 MacTools 主圖示，點按行為保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools のメニューバーアイコンを置き換えます。クリック時の動作は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 메뉴 막대 아이콘을 대체하며 클릭 동작은 유지합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt das MacTools-Menüleistensymbol; die Klickaktionen bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace l’icône MacTools dans la barre des menus sans modifier les actions du clic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye el icono de MacTools sin cambiar las acciones del clic."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui o ícone do MacTools sem alterar as ações de clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяет значок MacTools в строке меню, сохраняя действия при нажатии."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال أيقونة MacTools في شريط القوائم مع الحفاظ على سلوك النقر."
          }
        }
      }
    },
    "settings.occupiedFormat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app icon is already used by “%@”. Switch that plugin to a separate icon in its settings first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用图标已由「%@」使用。请先在其设置中切换为独立图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式圖示已由「%@」使用。請先在其設定中切換為獨立圖示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリアイコンは「%@」が使用中です。先にそのプラグインの設定で独立アイコンに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 아이콘을 ‘%@’에서 사용 중입니다. 먼저 해당 플러그인 설정에서 별도 아이콘으로 전환하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das App-Symbol wird bereits von „%@“ verwendet. Wechseln Sie dort zuerst zum separaten Symbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône est déjà utilisée par « %@ ». Passez d’abord ce plugin en icône distincte dans ses réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono ya lo usa «%@». Cambia primero ese plugin a un icono independiente en sus ajustes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone já está a ser usado por «%@». Mude primeiro esse plugin para um ícone separado nas suas definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок приложения уже используется плагином «%@». Сначала выберите отдельный значок в его настройках."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيقونة التطبيق مستخدمة بالفعل بواسطة «%@». بدّل ذلك الملحق إلى أيقونة مستقلة من إعداداته أولاً."
          }
        }
      }
    },
    "settings.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot change the display mode right now. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法切换显示方式，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法切換顯示方式，請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、表示方法を変更できません。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 표시 방식을 변경할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Darstellung kann gerade nicht geändert werden. Versuchen Sie es später erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer le mode d’affichage pour le moment. Réessayez plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar el modo ahora. Inténtalo más tarde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível mudar o modo agora. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас нельзя изменить режим отображения. Повторите попытку позже."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر تغيير وضع العرض الآن. حاول لاحقاً."
          }
        }
      }
    },
    "settings.invalidIcon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The icon is unavailable. The current display mode was kept."
          }
        },
        "zh-Hans": {
