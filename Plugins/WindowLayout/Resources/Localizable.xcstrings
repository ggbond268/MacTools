    "settings.inset.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inset from the visible screen area for almost maximize."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接近最大化时相对屏幕可视区域的内缩边距。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接近最大化時相對螢幕可視區域的內縮邊距。"
          }
        }
      }
    },
