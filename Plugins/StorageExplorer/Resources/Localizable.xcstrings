    "storageExplorer.resetZoom": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "إعادة ضبط التكبير" } },
        "de": { "stringUnit": { "state": "translated", "value": "Zoom zurücksetzen" } },
