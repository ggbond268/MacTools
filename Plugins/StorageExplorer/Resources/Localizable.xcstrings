    "storageExplorer.exploreDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看空间分布、查找大文件，审阅后移至废纸篓。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore disk usage, find large files, and review items before moving them to Trash."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看空間分布、尋找大檔案，審閱後移至垃圾桶。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherbelegung erkunden, große Dateien finden und vor dem Verschieben in den Papierkorb prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora el uso del disco, encuentra archivos grandes y revísalos antes de moverlos a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez l’espace disque, trouvez les gros fichiers et examinez-les avant de les placer dans la corbeille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの使用状況を確認し、大きなファイルを探して、確認後にゴミ箱へ移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 사용량을 살펴보고 큰 파일을 찾은 뒤 검토하여 휴지통으로 이동하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore o uso do disco, encontre ficheiros grandes e reveja-os antes de os mover para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучайте использование диска, находите большие файлы и проверяйте их перед перемещением в корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استكشف استخدام القرص واعثر على الملفات الكبيرة وراجعها قبل نقلها إلى سلة المهملات."
          }
        }
      }
    },
    "storageExplorer.changedOnDisk": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已更改。刷新可更新大小；移至废纸篓前会重新验证所选项目。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files changed. Refresh to update sizes; selected items are rechecked before moving to Trash."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案已更改。重新整理可更新大小；移至垃圾桶前會重新驗證所選項目。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien wurden geändert. Aktualisieren Sie die Größen; ausgewählte Objekte werden vor dem Papierkorb erneut geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos cambiaron. Actualiza los tamaños; los elementos seleccionados se comprueban antes de moverlos a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers ont changé. Actualisez les tailles ; les éléments sélectionnés sont revérifiés avant la Corbeille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが変更されました。更新するとサイズを再取得し、ゴミ箱へ移動する前に選択項目を再確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 변경되었습니다. 새로 고치면 크기가 갱신되며, 휴지통으로 이동하기 전에 선택 항목을 다시 확인합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros mudaram. Atualize os tamanhos; os itens selecionados são verificados antes de irem para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы изменились. Обновите размеры; выбранные объекты будут проверены перед перемещением в Корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت الملفات. حدّث الأحجام؛ ستتم إعادة التحقق من العناصر المحددة قبل نقلها إلى سلة المهملات."
          }
        }
      }
    },
