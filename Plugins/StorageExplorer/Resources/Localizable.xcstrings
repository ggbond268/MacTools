{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستكشف التخزين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher-Explorer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage Explorer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorador de almacenamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorateur de stockage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージエクスプローラー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간 탐색기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorador de armazenamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализатор диска"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储空间分析"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存空間分析"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحليل استخدام القرص بشكل مرئي مع التنقل الهرمي، وتحديد الملفات الكبيرة، والنقل إلى المهملات بعد المراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Visuelle Festplattenanalyse mit hierarchischer Navigation, Erkennung großer Dateien und Verschieben in den Papierkorb nach Überprüfung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visually analyze disk usage with hierarchical navigation, identify large files, and move to Trash after explicit review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza visualmente el uso del disco con navegación jerárquica, identifica archivos grandes y muévelos a la Papelera tras su revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez visuellement l'utilisation du disque grâce à une navigation hiérarchique, repérez les gros fichiers et mettez-les à la corbeille après examen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "階層構造でディスク使用状況を視覚的に分析し、大容量ファイルを特定して確認後にゴミ箱へ移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계층적 탐색으로 디스크 사용량을 시각적으로 분석하고, 대용량 파일을 식별하여 검토 후 휴지통으로 이동합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise visualmente o uso do disco com navegação hierárquica, identifique ficheiros grandes e mova para o Lixo após revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наглядный анализ использования диска с иерархической навигацией, поиск больших файлов и перемещение в корзину после проверки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以层级视图直观分析磁盘占用，找出大文件，在审阅确认后移至废纸篓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以層級檢視直觀分析磁碟佔用，找出大檔案，在審閱確認後移至垃圾桶"
          }
        }
      }
    },
