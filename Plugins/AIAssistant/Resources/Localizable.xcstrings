{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.unavailable.paused": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "AI Assistant shortcuts are paused." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "AI 助手快捷键已暂停。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "AI 助手快速鍵已暫停。" } }
      }
    },
    "action.unavailable.accessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Accessibility permission is required." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "需要辅助功能授权。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "需要輔助使用權限。" } }
      }
    },
    "action.unavailable.provider": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Configure an AI service first." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先配置 AI 服务。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請先設定 AI 服務。" } }
      }
    },
    "common.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Cancel" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "取消" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "取消" } }
      }
    },
    "common.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Delete" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "刪除" } }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "AI Assistant" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "AI 助手" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "AI 助手" } }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Process selected text with AI: translate, summarize, polish, and more." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "划词调用 AI 翻译、总结、润色等" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "透過快速鍵呼叫 AI 翻譯、摘要、潤飾等" } }
      }
    },
    "permission.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Accessibility" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "辅助功能授权" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "輔助使用權限" } }
      }
    },
    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Processing selected text requires reading the current selection." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "划词处理需要读取当前选中文本。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "劃詞處理需要讀取目前選取的文字。" } }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open System Settings → Privacy & Security → Accessibility and allow MacTools." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "前往系统设置 → 隐私与安全性 → 辅助功能，授权 MacTools。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "前往系統設定 → 隱私與安全性 → 輔助使用，授權 MacTools。" } }
      }
    },
    "permission.automation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Automation" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "自动化授权" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "自動化權限" } }
      }
    },
    "permission.automation.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Browser selection may require allowing MacTools to control the current browser." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "浏览器划词可能需要允许 MacTools 控制当前浏览器。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "瀏覽器劃詞可能需要允許 MacTools 控制目前瀏覽器。" } }
      }
    },
    "permission.automation.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "macOS will ask for automation permission the first time it controls a browser." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "macOS 会在首次控制浏览器时请求自动化授权。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "macOS 會在首次控制瀏覽器時要求自動化權限。" } }
      }
    },
    "permission.automation.status": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "On demand" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "按需确认" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "按需確認" } }
      }
    },
    "settings.service.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "AI Service" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "AI 服务" } },
