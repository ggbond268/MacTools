{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Window Layouts" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "窗口布局" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "視窗佈局" } }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Arrange the focused window and create custom layouts" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "排列聚焦窗口并创建自定义布局" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "排列聚焦視窗並建立自訂佈局" } }
      }
    },
    "permission.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Accessibility" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "辅助功能" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "輔助使用" } }
      }
    },
    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Used to read and adjust application window positions, sizes, and full-screen state." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于读取并调整应用窗口的位置、大小和全屏状态。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "用於讀取並調整應用程式視窗的位置、大小和全螢幕狀態。" } }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "In System Settings → Privacy & Security → Accessibility, allow MacTools." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在系统设置 → 隐私与安全性 → 辅助功能中允许 MacTools。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在系統設定 → 隱私權與安全性 → 輔助使用中允許 MacTools。" } }
      }
    },
    "settings.layout.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Window Spacing" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "窗口间距" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "視窗間距" } }
      }
    },
    "settings.gap.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Window Gaps" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "窗口间距" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "視窗間距" } }
      }
    },
    "settings.gap.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Leave space at screen edges and between adjacent tiled windows." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在屏幕边缘和相邻平铺窗口之间保留间距。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在螢幕邊緣和相鄰平鋪視窗之間保留間距。" } }
      }
    },
    "settings.reset.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Restore Defaults" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "恢复默认设置" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "回復預設設定" } }
      }
    },
    "settings.reset.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Restore layout behavior defaults without deleting custom commands or shortcuts." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "恢复布局行为默认值，不会删除自定义命令或快捷键。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "回復佈局行為預設值，不會刪除自訂指令或快速鍵。" } }
      }
    },
    "settings.reset.button": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Restore" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "恢复" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "回復" } }
      }
    },
    "settings.shortcuts.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Window Layout Shortcuts" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "窗口布局快捷键" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "視窗佈局快速鍵" } }
      }
    },
    "settings.shortcuts.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use a preset, then customize any global shortcut individually." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "可使用预设，也可逐项录制自己的全局快捷键。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "可使用預設，也可逐項錄製自己的全域快速鍵。" } }
      }
    },
    "settings.behavior.title": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Layout Behavior" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "布局行为" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "佈局行為" } } } },
    "settings.cycles.title": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Cycle Half-screen Sizes" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "循环半屏尺寸" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "循環半螢幕尺寸" } } } },
    "settings.cycles.description": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Repeat any half-screen command to cycle through one-half, two-thirds, and one-third on the same display." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "重复执行任一半屏命令时，在当前显示器上的二分之一、三分之二和三分之一之间循环。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "重複執行任一半螢幕指令時，在目前顯示器上的二分之一、三分之二和三分之一之間循環。" } } } },
    "settings.stageManager.title": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Avoid Stage Manager" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "避让台前调度" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "避讓幕前調度" } } } },
    "settings.stageManager.description": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Keep windows clear of visible Stage Manager thumbnails." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "台前调度缩略图可见时，不把窗口放到缩略图下方。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "幕前調度縮圖可見時，不將視窗放在縮圖下方。" } } } },
    "settings.feedback.title": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Show Command Feedback" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "显示命令反馈" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "顯示指令回饋" } } } },
    "settings.feedback.description": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Briefly show successful global shortcuts and trackpad gestures. Failures are always shown." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "使用全局快捷键或触控板手势时，短暂显示成功提示；失败始终显示。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "使用全域快捷鍵或觸控板手勢時，短暫顯示成功提示；失敗一律顯示。" } } } },
    "settings.preset.title": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Shortcut Preset" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "快捷键预设" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "快速鍵預設" } } } },
    "settings.preset.none": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "None" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "無" } } } },
    "settings.preset.controlOption": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Control–Option (⌃⌥)" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Control–Option (⌃⌥)" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "Control–Option (⌃⌥)" } } } },
    "settings.preset.optionCommand": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Option–Command (⌥⌘)" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Option–Command (⌥⌘)" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "Option–Command (⌥⌘)" } } } },
    "settings.preset.controlOptionCommand": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Control–Option–Command (⌃⌥⌘)" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Control–Option–Command (⌃⌥⌘)" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "Control–Option–Command (⌃⌥⌘)" } } } },
    "settings.preset.unavailable": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The shortcut preset cannot be applied right now." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前无法应用快捷键预设。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前無法套用快速鍵預設。" } } } },
    "settings.preset.sectionTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Shortcut Presets" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "快捷键预设" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "快速鍵預設" } } } },
    "settings.preset.current": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Current Shortcut Scheme" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前快捷键方案" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前快速鍵方案" } } } },
    "settings.preset.currentDescription": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Open the preset assistant to review changes and conflicts before applying." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开预设助手，先查看更改和冲突，再决定是否应用。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "開啟預設助理，先查看變更和衝突，再決定是否套用。" } } } },
    "settings.preset.currentBinding": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Current" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前" } } } },
    "settings.preset.proposedBinding": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Proposed" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "建议" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "建議" } } } },
    "settings.preset.changeButton": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Change…" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "更改…" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "更改…" } } } },
    "settings.preset.custom": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Custom" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "自定义" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "自訂" } } } },
    "settings.preset.selectionDescription": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Selecting a preset only updates the preview; it is not applied immediately." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择预设只会更新预览，不会立即应用。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "選擇預設只會更新預覽，不會立即套用。" } } } },
    "settings.preset.sheetTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Change Shortcut Preset" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "更改快捷键预设" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "更改快速鍵預設" } } } },
    "settings.preset.sheetDescription": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose a preset and review every change. No shortcuts change until you apply it." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择预设并逐项查看更改；在点击应用前，不会修改任何快捷键。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "選擇預設並逐項查看變更；在點按套用前，不會修改任何快速鍵。" } } } },
    "settings.preset.sheetPicker": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Preset to Preview" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "要预览的预设" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "要預覽的預設" } } } },
    "settings.preset.appliedStatus": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Applied" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "已应用" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "已套用" } } } },
    "settings.preset.notAppliedStatus": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Not Applied" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "尚未应用" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "尚未套用" } } } },
    "settings.preset.willChange": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Will Change" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "将更改" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "將更改" } } } },
    "settings.preset.unchanged": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No Change" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无更改" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "無變更" } } } },
    "settings.preset.conflictOwner": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Conflicts with “%@”" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "与“%@”冲突" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "與「%@」衝突" } } } },
    "settings.preset.resolveConflicts": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Resolve the marked shortcut conflicts before applying this preset." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先解决标记的快捷键冲突，再应用预设。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "請先解決標記的快速鍵衝突，再套用預設。" } } } },
    "settings.preset.notAppliedDescription": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No shortcuts change until you click Apply Preset." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "在点击“应用预设”前，不会修改任何快捷键。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "在點按「套用預設」前，不會修改任何快速鍵。" } } } },
    "settings.preset.preview": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Change Preview" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "更改预览" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "變更預覽" } } } },
    "settings.preset.previewUnavailable": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Preview is unavailable right now." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前无法预览。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前無法預覽。" } } } },
    "settings.preset.conflictCount": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%d shortcut conflicts" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "%d 个快捷键冲突" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "%d 個快速鍵衝突" } } } },
    "settings.preset.conflictCountOne": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "1 shortcut conflict" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "1 个快捷键冲突" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "1 個快速鍵衝突" } } } },
    "settings.preset.alreadyApplied": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "These shortcuts already match this preset." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前快捷键已与此预设一致。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前快速鍵已與此預設一致。" } } } },
    "settings.preset.changeCount": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%d changes" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "%d 项更改" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "%d 項變更" } } } },
    "settings.preset.changeCountOne": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "1 change" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "1 项更改" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "1 項變更" } } } },
    "settings.preset.applyTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Apply Shortcut Preset" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "应用快捷键预设" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "套用快速鍵預設" } } } },
    "settings.preset.applyDescription": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Only replace the previewed Window Layout shortcuts after confirmation." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "仅在确认后替换预览中列出的窗口布局快捷键。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "僅在確認後取代預覽中列出的視窗佈局快速鍵。" } } } },
    "settings.preset.applyButton": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Apply Preset" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "应用预设" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "套用預設" } } } },
    "settings.preset.confirmTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Apply “%@”?" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "应用“%@”？" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "套用「%@」？" } } } },
    "settings.preset.confirmMessage": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Window Layout shortcuts marked as changed in the preview will be replaced." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "预览中有变化的窗口布局快捷键将被替换。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "預覽中有變更的視窗佈局快速鍵將被取代。" } } } },
    "settings.preset.confirmButton": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Apply" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "应用" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "套用" } } } },
