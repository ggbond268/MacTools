    "category.installers.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتأثر التطبيقات المثبتة، ويمكن تنزيل الحزم مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installierte Apps bleiben erhalten; Installationspakete können erneut geladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed apps are unaffected; installers can be downloaded again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps instaladas no cambian; los instaladores pueden volver a descargarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps installées restent intactes ; les programmes peuvent être retéléchargés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのアプリには影響せず、インストーラは再ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 앱은 영향을 받지 않으며 설치 패키지를 다시 다운로드할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações instaladas não são afetadas; os instaladores podem ser transferidos novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установленные приложения не изменятся; установщики можно скачать заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的应用不受影响，安装包需要时可重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝的 App 不受影響，需要時可重新下載安裝套件。"
          }
        }
      }
    },
