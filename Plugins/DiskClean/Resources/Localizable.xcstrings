          "stringUnit": {
            "state": "translated",
            "value": "永久删除不进废纸篓，无法恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent deletion skips the Trash and can’t be undone."
          }
        },
        "zh-Hant": {
