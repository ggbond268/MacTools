    "category.developerArtifacts.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتأثر الشيفرة المصدرية وعمليات الإيداع. يجب إعادة تثبيت التبعيات وبناء المخرجات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellcode und Commits bleiben erhalten. Abhängigkeiten und Artefakte müssen neu erstellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source code and commits are unchanged. Dependencies and artifacts must be rebuilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código fuente y los commits no cambian. Hay que reinstalar dependencias y recompilar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code source et les commits restent intacts. Les dépendances et artefacts doivent être reconstruits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースコードとコミットには影響しません。依存関係と成果物の再構築が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 코드와 커밋은 유지됩니다. 종속성과 산출물을 다시 빌드해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O código-fonte e os commits não são afetados. Dependências e artefactos devem ser recriados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный код и коммиты не изменятся. Зависимости и артефакты нужно пересобрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源码与提交不受影响，依赖需要重新安装、产物需要重新构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始碼與提交不受影響，需重新安裝相依套件並重建產物。"
          }
        }
      }
    },
