    }},
    "gesture.category.longTouch": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "لمس مطول"}},
      "de": {"stringUnit": {"state": "translated", "value": "Langes Berühren"}},
      "en": {"stringUnit": {"state": "translated", "value": "Touch and Hold"}},
      "es": {"stringUnit": {"state": "translated", "value": "Mantener pulsado"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Toucher prolongé"}},
      "ja": {"stringUnit": {"state": "translated", "value": "長押し"}},
      "ko": {"stringUnit": {"state": "translated", "value": "길게 터치"}},
      "pt": {"stringUnit": {"state": "translated", "value": "Toque prolongado"}},
      "ru": {"stringUnit": {"state": "translated", "value": "Долгое касание"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "长触"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "長觸"}}
    }},
    "gesture.twoFingerClick": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "نقرة فعلية بإصبعين"}},
      "de": {"stringUnit": {"state": "translated", "value": "Zwei-Finger-Klick"}},
      "en": {"stringUnit": {"state": "translated", "value": "Two-Finger Click"}},
      "es": {"stringUnit": {"state": "translated", "value": "Clic con dos dedos"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Clic à deux doigts"}},
      "ja": {"stringUnit": {"state": "translated", "value": "2本指クリック"}},
      "ko": {"stringUnit": {"state": "translated", "value": "두 손가락 클릭"}},
      "pt": {"stringUnit": {"state": "translated", "value": "Clique com dois dedos"}},
      "ru": {"stringUnit": {"state": "translated", "value": "Щелчок двумя пальцами"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "双指按下点击"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "雙指按下點按"}}
    }},
    "gesture.threeFingerClick": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "نقرة فعلية بثلاثة أصابع"}},
      "de": {"stringUnit": {"state": "translated", "value": "Drei-Finger-Klick"}},
      "en": {"stringUnit": {"state": "translated", "value": "Three-Finger Click"}},
      "es": {"stringUnit": {"state": "translated", "value": "Clic con tres dedos"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Clic à trois doigts"}},
      "ja": {"stringUnit": {"state": "translated", "value": "3本指クリック"}},
      "ko": {"stringUnit": {"state": "translated", "value": "세 손가락 클릭"}},
      "pt": {"stringUnit": {"state": "translated", "value": "Clique com três dedos"}},
      "ru": {"stringUnit": {"state": "translated", "value": "Щелчок тремя пальцами"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "三指按下点击"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "三指按下點按"}}
    }},
    "gesture.demo.clickFormat": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "أبقِ %d أصابع ملامسة واضغط على لوحة التعقب حتى تسمع نقرة فعلية واحدة."}},
      "de": {"stringUnit": {"state": "translated", "value": "%d Finger auflegen und das Trackpad drücken, bis es einmal physisch klickt."}},
      "en": {"stringUnit": {"state": "translated", "value": "Keep %d fingers touching and press the trackpad until it physically clicks once."}},
      "es": {"stringUnit": {"state": "translated", "value": "Mantén %d dedos apoyados y presiona el trackpad hasta producir un clic físico."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Gardez %d doigts posés et appuyez sur le trackpad jusqu’à produire un clic physique."}},
      "ja": {"stringUnit": {"state": "translated", "value": "%d本の指を触れたまま、1回物理的にクリックするまでトラックパッドを押します。"}},
      "ko": {"stringUnit": {"state": "translated", "value": "%d개의 손가락을 댄 채 한 번 물리적으로 클릭될 때까지 트랙패드를 누르세요."}},
      "pt": {"stringUnit": {"state": "translated", "value": "Mantenha %d dedos apoiados e pressione o trackpad até produzir um clique físico."}},
      "ru": {"stringUnit": {"state": "translated", "value": "Удерживайте %d пальца на трекпаде и нажмите до одного физического щелчка."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "保持 %d 指接触并按下触控板，直到产生一次物理点击。"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "保持 %d 指接觸並按下觸控板，直到產生一次實體點按。"}}
    }},
    "gesture.conflict.twoFingerClick": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "يستبدل هذا عادةً النقر الثانوي بإصبعين (النقر بزر الماوس الأيمن) في macOS."}},
      "de": {"stringUnit": {"state": "translated", "value": "Ersetzt normalerweise den Zwei-Finger-Sekundärklick (Rechtsklick) von macOS."}},
      "en": {"stringUnit": {"state": "translated", "value": "This usually replaces macOS two-finger secondary click (right-click)."}},
      "es": {"stringUnit": {"state": "translated", "value": "Normalmente sustituye el clic secundario con dos dedos de macOS (clic derecho)."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Remplace généralement le clic secondaire à deux doigts de macOS (clic droit)."}},
      "ja": {"stringUnit": {"state": "translated", "value": "通常、macOSの2本指の副ボタンクリック（右クリック）に置き換わります。"}},
      "ko": {"stringUnit": {"state": "translated", "value": "일반적으로 macOS의 두 손가락 보조 클릭(오른쪽 클릭)을 대체합니다."}},
      "pt": {"stringUnit": {"state": "translated", "value": "Normalmente substitui o clique secundário com dois dedos do macOS (botão direito)."}},
      "ru": {"stringUnit": {"state": "translated", "value": "Обычно заменяет вторичный щелчок двумя пальцами (правую кнопку) в macOS."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "通常会替代 macOS 的双指辅助点按（右键）。"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "通常會取代 macOS 的雙指輔助點按（右鍵）。"}}
    }},
    "settings.mappings.tipTapGuide.hold": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "ضع إصبعًا أو إصبعين وأبقِهما ثابتين."}},
      "de": {"stringUnit": {"state": "translated", "value": "Legen Sie einen oder zwei Finger auf und halten Sie sie ruhig."}},
      "en": {"stringUnit": {"state": "translated", "value": "Place one or two fingers and keep them still."}},
      "es": {"stringUnit": {"state": "translated", "value": "Apoya uno o dos dedos y mantenlos quietos."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Posez un ou deux doigts et gardez-les immobiles."}},
      "ja": {"stringUnit": {"state": "translated", "value": "1 本または 2 本の指を置き、動かさずに保ちます。"}},
      "ko": {"stringUnit": {"state": "translated", "value": "한두 손가락을 올려놓고 움직이지 마세요."}},
      "pt": {"stringUnit": {"state": "translated", "value": "Coloque um ou dois dedos e mantenha-os imóveis."}},
      "ru": {"stringUnit": {"state": "translated", "value": "Положите один или два пальца и держите их неподвижно."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "先放下 1 或 2 指并保持不动。"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "先放下 1 或 2 指並保持不動。"}}
    }},
    "settings.mappings.tipTapGuide.tap": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "بإصبع آخر، انقر يسار أو يمين مجموعة الأصابع الثابتة."}},
      "de": {"stringUnit": {"state": "translated", "value": "Tippen Sie mit einem weiteren Finger links oder rechts neben die ruhenden Finger."}},
      "en": {"stringUnit": {"state": "translated", "value": "With another finger, tap to the left or right of the fixed-finger group."}},
      "es": {"stringUnit": {"state": "translated", "value": "Con otro dedo, toca a la izquierda o derecha del grupo de dedos fijos."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Avec un autre doigt, touchez à gauche ou à droite des doigts fixes."}},
      "ja": {"stringUnit": {"state": "translated", "value": "別の指で、固定した指の左側または右側をタップします。"}},
      "ko": {"stringUnit": {"state": "translated", "value": "다른 손가락으로 고정한 손가락의 왼쪽이나 오른쪽을 탭하세요."}},
      "pt": {"stringUnit": {"state": "translated", "value": "Com outro dedo, toque à esquerda ou à direita dos dedos fixos."}},
      "ru": {"stringUnit": {"state": "translated", "value": "Другим пальцем коснитесь слева или справа от неподвижных пальцев."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "用另一指在固定手指组的左侧或右侧轻点。"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "用另一指在固定手指組的左側或右側輕點。"}}
    }},
    "settings.mappings.tipTapGuide.repeat": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "ارفع إصبع النقر فقط، وأبقِ الأصابع الثابتة ليتكرر النقر."}},
      "de": {"stringUnit": {"state": "translated", "value": "Heben Sie nur den tippenden Finger an; die ruhenden Finger bleiben für weitere Tipps liegen."}},
      "en": {"stringUnit": {"state": "translated", "value": "Lift only the tapping finger; keep the fixed fingers down to continue."}},
      "es": {"stringUnit": {"state": "translated", "value": "Levanta solo el dedo que toca; mantén los dedos fijos apoyados para continuar."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Relevez uniquement le doigt qui touche ; gardez les doigts fixes posés pour continuer."}},
      "ja": {"stringUnit": {"state": "translated", "value": "タップした指だけを離し、固定した指は置いたまま繰り返します。"}},
      "ko": {"stringUnit": {"state": "translated", "value": "탭한 손가락만 떼고 고정 손가락은 둔 채 계속하세요."}},
      "pt": {"stringUnit": {"state": "translated", "value": "Levante apenas o dedo que toca; mantenha os dedos fixos apoiados para continuar."}},
      "ru": {"stringUnit": {"state": "translated", "value": "Поднимайте только касающийся палец, оставляя неподвижные пальцы для продолжения."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "只抬起轻点手指；固定手指保持接触即可继续轻点。"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "只抬起輕點手指；固定手指保持接觸即可繼續輕點。"}}
    }},
    "editor.shortcut.reusedFormat": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "يُستخدم هذا الاختصار أيضًا بواسطة: %@. يُسمح بإعادة الاستخدام."}},
      "de": {"stringUnit": {"state": "translated", "value": "Dieses Kürzel wird auch verwendet von: %@. Mehrfachverwendung ist erlaubt."}},
      "en": {"stringUnit": {"state": "translated", "value": "This shortcut is also used by: %@. Reuse is allowed."}},
      "es": {"stringUnit": {"state": "translated", "value": "Este atajo también se usa en: %@. Se permite reutilizarlo."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Ce raccourci est également utilisé par : %@. Sa réutilisation est autorisée."}},
      "ja": {"stringUnit": {"state": "translated", "value": "このショートカットは %@ でも使用されています。再利用できます。"}},
      "ko": {"stringUnit": {"state": "translated", "value": "이 단축키는 다음에서도 사용됩니다: %@. 재사용할 수 있습니다."}},
      "pt": {"stringUnit": {"state": "translated", "value": "Este atalho também é usado por: %@. A reutilização é permitida."}},
      "ru": {"stringUnit": {"state": "translated", "value": "Это сочетание также используется для: %@. Повторное использование разрешено."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "此快捷键也用于：%@。允许重复使用。"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "此快速鍵也用於：%@。允許重複使用。"}}
    }},
