    "settings.mappings.noMatches.title": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "لا توجد تعيينات مطابقة"}},
      "de": {"stringUnit": {"state": "translated", "value": "Keine passenden Zuordnungen"}},
      "en": {"stringUnit": {"state": "translated", "value": "No Matching Mappings"}},
      "es": {"stringUnit": {"state": "translated", "value": "No hay asignaciones coincidentes"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Aucune association correspondante"}},
      "ja": {"stringUnit": {"state": "translated", "value": "一致するマッピングがありません"}},
      "ko": {"stringUnit": {"state": "translated", "value": "일치하는 매핑 없음"}},
      "pt": {"stringUnit": {"state": "translated", "value": "Nenhum mapeamento correspondente"}},
