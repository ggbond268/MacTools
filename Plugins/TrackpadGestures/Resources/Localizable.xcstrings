    "error.listenerUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start gesture monitoring. Check permissions and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动手势监听，请检查权限后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر بدء مراقبة الإيماءات. تحقق من الأذونات وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gestenüberwachung konnte nicht gestartet werden. Überprüfen Sie die Berechtigungen und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el monitoreo de gestos. Verifique los permisos y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer la surveillance des gestes. Vérifiez les autorisations et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジェスチャ監視を開始できませんでした。権限を確認して、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작 모니터링을 시작할 수 없습니다. 권한을 확인하고 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o monitoramento de gestos. Verifique as permissões e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить мониторинг жестов. Проверьте разрешения и повторите попытку."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動手勢監控。檢查權限並重試。"
          }
        }
      }
    },
