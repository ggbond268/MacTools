    "gesture.demo.doubleTapFormat": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "المس ثم حرّر مرتين متتاليتين باستخدام %d أصابع."}},
      "de": {"stringUnit": {"state": "translated", "value": "Mit %d Fingern zweimal kurz hintereinander berühren und loslassen."}},
      "en": {"stringUnit": {"state": "translated", "value": "Touch and release twice in succession with %d fingers."}},
      "es": {"stringUnit": {"state": "translated", "value": "Toca y suelta dos veces seguidas con %d dedos."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Touchez et relâchez deux fois de suite avec %d doigts."}},
      "ja": {"stringUnit": {"state": "translated", "value": "%d本の指で続けて2回タッチして放します。"}},
      "ko": {"stringUnit": {"state": "translated", "value": "%d개의 손가락으로 연속 두 번 터치하고 놓습니다."}},
      "pt": {"stringUnit": {"state": "translated", "value": "Toque e solte duas vezes seguidas com %d dedos."}},
      "ru": {"stringUnit": {"state": "translated", "value": "Дважды подряд коснитесь и отпустите %d пальцами."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "%d 指连续轻触并抬起两次。"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "%d 指連續輕觸並抬起兩次。"}}
    }},
    "gesture.demo.tipTapFormat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %d fingers still, then repeatedly tap the selected area with one more finger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 %d 指不动，再用一指反复轻点指定区域。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ %d من أصابعك ثابتة، ثم انقر بشكل متكرر على المنطقة المحددة بإصبع إضافي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie %d Finger ruhig und tippen Sie dann mit einem weiteren Finger wiederholt auf den ausgewählten Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga %d dedos quietos y toque repetidamente el área seleccionada con un dedo más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez %d doigts immobiles, puis touchez plusieurs fois la zone sélectionnée avec un doigt supplémentaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 本の指を動かさず、もう 1 本の指で選択した領域を繰り返しタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d개의 손가락을 가만히 유지한 다음 손가락 하나를 더 사용해 선택한 영역을 반복해서 탭하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha %d dedos imóveis e toque repetidamente na área selecionada com mais um dedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %d пальца неподвижно, затем несколько раз коснитесь выбранной области еще одним пальцем."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 %d 根手指不動，再用一根手指反覆輕點所選區域。"
          }
        }
      }
    },
    "gesture.demo.tapFormat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and release with %d fingers together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 指同时轻触并抬起。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس ثم حرّر باستخدام %d من أصابعك معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %d Fingern gleichzeitig berühren und loslassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y suelta con %d dedos juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et relâchez avec %d doigts ensemble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 本の指を合わせてタッチして放します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d개의 손가락을 함께 터치하고 놓습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e solte com %d dedos juntos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь и отпустите, соединив %d пальцы."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 %d 手指併攏觸碰並釋放。"
          }
        }
      }
    },
    "gesture.demo.longTouchFormat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %d fingers touching for about half a second."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 指保持接触约半秒。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر في لمس أصابع %d لمدة نصف ثانية تقريبًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühren Sie %d Finger etwa eine halbe Sekunde lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén los dedos de %d tocándose durante aproximadamente medio segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez %d doigts en contact pendant environ une demi-seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 本の指を約 0.5 秒間触れたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d개의 손가락을 약 0.5초 동안 계속 터치하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os dedos %d se tocando por cerca de meio segundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите пальцы %d соприкасающимися примерно полсекунды."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 %d 手指接觸約半秒。"
          }
        }
      }
    },
    "settings.typing.title": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "حماية الكتابة"}},
      "de": {"stringUnit": {"state": "translated", "value": "Eingabeschutz"}},
      "en": {"stringUnit": {"state": "translated", "value": "Typing Protection"}},
      "es": {"stringUnit": {"state": "translated", "value": "Protección al escribir"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Protection de saisie"}},
      "ja": {"stringUnit": {"state": "translated", "value": "入力保護"}},
      "ko": {"stringUnit": {"state": "translated", "value": "입력 보호"}},
      "pt": {"stringUnit": {"state": "translated", "value": "Proteção ao digitar"}},
      "ru": {"stringUnit": {"state": "translated", "value": "Защита при вводе"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入保护"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入保護"}}
    }},
    "settings.typing.ignore.title": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "تجاهل الإيماءات أثناء الكتابة"}},
      "de": {"stringUnit": {"state": "translated", "value": "Gesten beim Tippen ignorieren"}},
      "en": {"stringUnit": {"state": "translated", "value": "Ignore Gestures While Typing"}},
      "es": {"stringUnit": {"state": "translated", "value": "Ignorar gestos al escribir"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Ignorer les gestes pendant la saisie"}},
      "ja": {"stringUnit": {"state": "translated", "value": "入力中はジェスチャを無視"}},
      "ko": {"stringUnit": {"state": "translated", "value": "입력 중 제스처 무시"}},
      "pt": {"stringUnit": {"state": "translated", "value": "Ignorar gestos ao digitar"}},
      "ru": {"stringUnit": {"state": "translated", "value": "Игнорировать жесты при вводе"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入时忽略手势"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入時忽略手勢"}}
    }},
    "settings.typing.ignore.description": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "يوقف التعرف مؤقتًا أثناء الكتابة لمنع إيماءات لوحة التعقب غير المقصودة."}},
      "de": {"stringUnit": {"state": "translated", "value": "Pausiert die Erkennung beim Tippen, um versehentliche Trackpad-Gesten zu vermeiden."}},
      "en": {"stringUnit": {"state": "translated", "value": "Pauses recognition while typing to prevent accidental trackpad gestures."}},
      "es": {"stringUnit": {"state": "translated", "value": "Pausa el reconocimiento al escribir para evitar gestos accidentales en el trackpad."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Suspend la reconnaissance pendant la saisie pour éviter les gestes accidentels sur le trackpad."}},
      "ja": {"stringUnit": {"state": "translated", "value": "入力中は認識を一時停止し、トラックパッドの誤操作を防ぎます。"}},
      "ko": {"stringUnit": {"state": "translated", "value": "입력 중 인식을 일시 중지하여 트랙패드 오작동을 방지합니다."}},
      "pt": {"stringUnit": {"state": "translated", "value": "Pausa o reconhecimento ao digitar para evitar gestos acidentais no trackpad."}},
      "ru": {"stringUnit": {"state": "translated", "value": "Приостанавливает распознавание во время ввода, предотвращая случайные жесты на трекпаде."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "按下普通按键时暂停识别，避免手掌误触触控板。"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "按下普通按鍵時暫停辨識，避免手掌誤觸觸控板。"}}
    }},
    "settings.typing.grace.title": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "التأخير بعد الكتابة"}},
      "de": {"stringUnit": {"state": "translated", "value": "Verzögerung nach dem Tippen"}},
      "en": {"stringUnit": {"state": "translated", "value": "Delay After Typing"}},
      "es": {"stringUnit": {"state": "translated", "value": "Retardo después de escribir"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Délai après la saisie"}},
      "ja": {"stringUnit": {"state": "translated", "value": "入力後の遅延"}},
      "ko": {"stringUnit": {"state": "translated", "value": "입력 후 지연"}},
      "pt": {"stringUnit": {"state": "translated", "value": "Atraso após digitar"}},
      "ru": {"stringUnit": {"state": "translated", "value": "Задержка после ввода"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "停止输入后的延迟"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "停止輸入後的延遲"}}
    }},
    "settings.typing.grace.description": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "يستمر الإيقاف بعد آخر ضغطة؛ التأخير الأقصر أسرع، والأطول يقلل اللمسات العرضية. الافتراضي 0.4 ثانية."}},
      "de": {"stringUnit": {"state": "translated", "value": "Pausiert nach dem letzten Tastendruck weiter. Kürzer reagiert schneller, länger verhindert mehr Fehlberührungen. Standard: 0,4 Sekunden."}},
      "en": {"stringUnit": {"state": "translated", "value": "Continues pausing after the last key event. Shorter responds sooner; longer prevents more accidental gestures. Default: 0.4 seconds."}},
      "es": {"stringUnit": {"state": "translated", "value": "Mantiene la pausa tras la última pulsación. Un valor menor responde antes; uno mayor evita más gestos accidentales. Predeterminado: 0,4 segundos."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Prolonge la pause après la dernière frappe. Un délai court réagit plus vite ; un délai long évite davantage de gestes accidentels. Valeur par défaut : 0,4 seconde."}},
      "ja": {"stringUnit": {"state": "translated", "value": "最後のキー入力後も一時停止します。短いほど素早く反応し、長いほど誤操作を防ぎます。デフォルトは 0.4 秒です。"}},
      "ko": {"stringUnit": {"state": "translated", "value": "마지막 키 입력 후에도 일시 중지합니다. 짧으면 더 빨리 반응하고, 길면 오작동을 더 줄입니다. 기본값은 0.4초입니다."}},
      "pt": {"stringUnit": {"state": "translated", "value": "Mantém a pausa após a última tecla. Um valor menor responde antes; um maior evita mais gestos acidentais. Padrão: 0,4 segundos."}},
      "ru": {"stringUnit": {"state": "translated", "value": "Продлевает паузу после последнего нажатия. Меньшее значение быстрее реагирует, большее предотвращает больше случайных жестов. По умолчанию: 0,4 секунды."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "最后一次按键后继续暂停识别；较短更灵敏，较长可减少更多误触；默认 0.4 秒。"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "最後一次按鍵後繼續暫停辨識；較短更靈敏，較長可減少更多誤觸；預設 0.4 秒。"}}
    }},
    "settings.typing.grace.valueFormat": {"localizations": {
      "ar": {"stringUnit": {"state": "translated", "value": "%.1f ث"}},
      "de": {"stringUnit": {"state": "translated", "value": "%.1f s"}},
      "en": {"stringUnit": {"state": "translated", "value": "%.1f s"}},
      "es": {"stringUnit": {"state": "translated", "value": "%.1f s"}},
      "fr": {"stringUnit": {"state": "translated", "value": "%.1f s"}},
      "ja": {"stringUnit": {"state": "translated", "value": "%.1f 秒"}},
      "ko": {"stringUnit": {"state": "translated", "value": "%.1f초"}},
      "pt": {"stringUnit": {"state": "translated", "value": "%.1f s"}},
      "ru": {"stringUnit": {"state": "translated", "value": "%.1f с"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "%.1f 秒"}},
      "zh-Hant": {"stringUnit": {"state": "translated", "value": "%.1f 秒"}}
    }},
    "gesture.conflict.secondaryClick": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS does not identify native-click sources. MacTools correlates a click only while one gesture candidate is active; a simultaneous external-mouse click may conflict."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不提供原生点击来源。MacTools 仅在一个手势候选活动时关联点击；同时点击外接鼠标时可能发生冲突。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحدد macOS مصدر النقرات الأصلية. يربط MacTools النقرة فقط عند نشاط مرشح إيماءة واحد؛ وقد تتعارض نقرة متزامنة من ماوس خارجي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS identifiziert die Quelle nativer Klicks nicht. MacTools ordnet einen Klick nur bei genau einem aktiven Gestenkandidaten zu; ein gleichzeitiger Klick mit einer externen Maus kann kollidieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no identifica el origen de los clics nativos. MacTools solo relaciona un clic cuando hay un candidato de gesto activo; un clic simultáneo de un ratón externo puede generar un conflicto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’identifie pas la source des clics natifs. MacTools n’associe un clic que lorsqu’un seul geste candidat est actif ; un clic simultané avec une souris externe peut créer un conflit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS はネイティブクリックの入力元を識別しません。MacTools は候補ジェスチャが 1 つだけ有効な間にクリックを関連付けます。外付けマウスの同時クリックは競合する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 기본 클릭의 입력 장치를 식별하지 않습니다. MacTools는 제스처 후보가 하나만 활성화된 동안 클릭을 연결하며, 외장 마우스를 동시에 클릭하면 충돌할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não identifica a origem dos cliques nativos. O MacTools só associa um clique enquanto há um candidato de gesto ativo; um clique simultâneo de um mouse externo pode causar conflito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не определяет источник системных щелчков. MacTools связывает щелчок только с одним активным кандидатом жеста; одновременный щелчок внешней мышью может конфликтовать."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不提供原生點按來源。MacTools 僅在一個手勢候選活動時關聯點按；同時點按外接滑鼠時可能發生衝突。"
          }
        }
      }
    },
    "gesture.conflict.threeFinger": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May conflict with Look Up & Data Detectors or three-finger dragging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能与“查询与数据检测器”或三指拖移冲突。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتعارض مع أدوات البحث والبيانات أو السحب بثلاثة أصابع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann mit Look Up & Data Detectors oder dem Ziehen mit drei Fingern in Konflikt geraten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede entrar en conflicto con los detectores de búsqueda y datos o al arrastrar con tres dedos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut entrer en conflit avec les détecteurs de recherche et de données ou avec le glissement à trois doigts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルックアップとデータ検出機能または 3 本指のドラッグと競合する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조회 및 데이터 탐지기 또는 세 손가락 드래그와 충돌할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode entrar em conflito com Look Up & Data Detectors ou arrastar com três dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может конфликтовать с поиском и детекторами данных или перетаскиванием тремя пальцами."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能與查找和資料偵測器或三指拖曳發生衝突。"
          }
        }
      }
    },
    "gesture.conflict.fourFinger": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May conflict with Mission Control, App Exposé, or full-screen app switching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能与调度中心、App Exposé 或全屏切换手势冲突。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتعارض مع Mission Control أو App Exposé أو تبديل التطبيق بملء الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise Konflikt mit Mission Control, App Exposé oder Vollbild-App-Wechsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede entrar en conflicto con Mission Control, App Exposé o el cambio de aplicación en pantalla completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut entrer en conflit avec Mission Control, App Exposé ou le changement d'application en plein écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Control、App Exposé、または全画面アプリの切り替えと競合する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Control, App Exposé 또는 전체 화면 앱 전환과 충돌할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode entrar em conflito com o Mission Control, App Exposé ou alternância de aplicativos em tela cheia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может конфликтовать с Mission Control, App Exposé или полноэкранным переключением приложений."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能與 Mission Control、App Exposé 或全螢幕應用程式切換發生衝突。"
          }
        }
      }
    },
