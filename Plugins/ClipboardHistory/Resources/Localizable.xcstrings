    "settings.exclusions.footnote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد الاستبعاد على التطبيق الأمامي الذي لوحظ عند النسخ، ولا يحل محل مدير كلمات المرور أو حماية الإدخال الآمن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ausschluss basiert auf der beim Kopieren beobachteten Vordergrund-App und ersetzt keinen Passwortmanager oder Schutz für sichere Eingaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclusion is based on the frontmost app observed when copying and doesn’t replace a password manager or secure-input protection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exclusión se basa en la app en primer plano al copiar y no sustituye a un gestor de contraseñas ni a la entrada segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exclusion repose sur l’app au premier plan lors de la copie et ne remplace pas un gestionnaire de mots de passe ni la saisie sécurisée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "除外はコピー時に最前面だったアプリに基づき、パスワードマネージャーや安全な入力保護の代わりにはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제외는 복사 시 감지된 전면 앱을 기준으로 하며 암호 관리자나 보안 입력 보호를 대체하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão se baseia no app em primeiro plano ao copiar e não substitui um gerenciador de senhas nem a entrada segura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исключение определяется приложением на переднем плане при копировании и не заменяет менеджер паролей или защищённый ввод."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排除依据是复制发生时观察到的前台应用，不能替代密码管理器或安全输入保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排除依據是複製時偵測到的前景 App，不能取代密碼管理器或安全輸入保護。"
          }
        }
      }
    },
