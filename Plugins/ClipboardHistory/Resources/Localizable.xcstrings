    "action.open.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح لوحة سجل الحافظة المحلية القابلة للبحث؛ يضغط الاختصار العام مرة أخرى لإغلاقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchbaren lokalen Zwischenablageverlauf öffnen; erneutes Drücken des globalen Kurzbefehls schließt ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the searchable local clipboard history panel; press its global shortcut again to close it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el panel local del historial con búsqueda; vuelve a pulsar el atajo global para cerrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le panneau local et consultable de l’historique ; appuyez à nouveau sur son raccourci global pour le fermer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索可能なローカルのクリップボード履歴パネルを開きます。グローバルショートカットをもう一度押すと閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 가능한 로컬 클립보드 기록 패널을 엽니다. 전역 단축키를 다시 누르면 닫힙니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o painel pesquisável do histórico local; pressione o atalho global novamente para fechá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть локальную панель истории буфера обмена с поиском; повторное нажатие глобального сочетания закроет её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开可搜索的本机剪贴板历史面板；再次按下全局快捷键可关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟可搜尋的本機剪貼簿記錄面板；再次按下全域快速鍵可關閉。"
          }
        }
