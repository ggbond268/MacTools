    "saved.error.duplicateKeyword": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "الكلمة %@ معيّنة بالفعل لمقتطف آخر." } },
        "de": { "stringUnit": { "state": "translated", "value": "Das Kürzel %@ ist bereits einem anderen Textbaustein zugewiesen." } },
        "en": { "stringUnit": { "state": "translated", "value": "The keyword %@ is already assigned to another snippet." } },
        "es": { "stringUnit": { "state": "translated", "value": "La palabra clave %@ ya está asignada a otro fragmento." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le mot-clé %@ est déjà attribué à un autre extrait." } },
        "ja": { "stringUnit": { "state": "translated", "value": "キーワード %@ は別のスニペットに割り当てられています。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "키워드 %@은(는) 다른 스니펫에 이미 지정되어 있습니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "A palavra-chave %@ já está atribuída a outro trecho." } },
