    "setup.collection.readyDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التخزين الآمن جاهز. تحتفظ سلسلة المفاتيح بالمفتاح المحلي فقط، ولا يلزم استخدام سلسلة مفاتيح iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der sichere Speicher ist bereit. Der Schlüsselbund enthält nur den lokalen Schlüssel; iCloud-Schlüsselbund ist nicht erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure storage is ready. Keychain stores only the local key; iCloud Keychain is not required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento seguro está listo. El Llavero solo guarda la clave local; no se requiere el Llavero de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage sécurisé est prêt. Le trousseau ne contient que la clé locale ; le trousseau iCloud n’est pas requis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なストレージの準備が完了しました。キーチェーンにはローカルキーのみ保存され、iCloudキーチェーンは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 저장 공간이 준비되었습니다. 키체인에는 로컬 키만 저장되며 iCloud 키체인은 필요하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento seguro está pronto. As Chaves guardam apenas a chave local; as Chaves do iCloud não são necessárias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищённое хранилище готово. В Связке ключей находится только локальный ключ; Связка ключей iCloud не требуется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全存储已就绪。钥匙串只保存本机密钥；不需要 iCloud 钥匙串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
