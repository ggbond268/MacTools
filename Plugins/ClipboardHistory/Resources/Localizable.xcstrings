    "panel.richText.previewSimplified": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعرض النص المنسق الكبير كنص عادي للحفاظ على الاستجابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großer formatierter Text wird für eine flüssige Darstellung als Klartext angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large rich text is shown as plain text to keep the preview responsive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto enriquecido grande se muestra como texto sin formato para mantener la fluidez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte enrichi volumineux est affiché en texte brut pour préserver la fluidité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作を軽快に保つため、大きなリッチテキストは標準テキストでプレビューされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원활한 미리보기를 위해 큰 서식 있는 텍스트는 일반 텍스트로 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Textos formatados grandes são mostrados como texto simples para manter a fluidez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для быстрой работы большой форматированный текст показан как обычный текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为保持流畅，大型富文本以纯文本预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為保持流暢，大型富文字會以純文字預覽。"
          }
        }
      }
    },
    "shortcut.pastePlain.title": {
      "localizations": {
