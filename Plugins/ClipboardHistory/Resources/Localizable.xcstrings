    "shortcut.privateCopy.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ التحديد الحالي دون قراءة محتوى الحافظة أو حفظه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Auswahl kopieren, ohne den Inhalt der Zwischenablage zu lesen oder zu speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the current selection without reading or saving this clipboard content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la selección actual sin leer ni guardar este contenido del portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez la sélection actuelle sans lire ni enregistrer ce contenu du presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の選択内容を、クリップボードの内容を読み取ったり保存したりせずにコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 선택 항목을 클립보드 내용을 읽거나 저장하지 않고 복사합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia a seleção atual sem ler nem salvar este conteúdo da área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать выделенное, не читая и не сохраняя содержимое буфера обмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制当前选择，但不读取或保存这次剪贴板内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製目前的選取內容，但不讀取或儲存此次剪貼簿內容。"
          }
        }
      }
    },
