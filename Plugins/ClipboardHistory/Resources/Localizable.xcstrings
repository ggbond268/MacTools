        "ar": { "stringUnit": { "state": "translated", "value": "هل تريد استخدام «%@» على أي حال؟" } }, "de": { "stringUnit": { "state": "translated", "value": "„%@“ trotzdem verwenden?" } }, "en": { "stringUnit": { "state": "translated", "value": "Use “%@” Anyway?" } }, "es": { "stringUnit": { "state": "translated", "value": "¿Usar «%@» de todos modos?" } }, "fr": { "stringUnit": { "state": "translated", "value": "Utiliser « %@ » quand même ?" } }, "ja": { "stringUnit": { "state": "translated", "value": "「%@」をこのまま使用しますか？" } }, "ko": { "stringUnit": { "state": "translated", "value": "“%@”을(를) 그래도 사용하시겠습니까?" } }, "pt": { "stringUnit": { "state": "translated", "value": "Usar “%@” mesmo assim?" } }, "ru": { "stringUnit": { "state": "translated", "value": "Всё равно использовать «%@»?" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "仍要使用“%@”？" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "仍要使用「%@」？" } }
