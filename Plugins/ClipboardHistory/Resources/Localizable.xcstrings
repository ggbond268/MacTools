    "settings.sequentialPaste.dismiss.description": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تظهر اللوحة القابلة للنقل تلقائيًا بعد اللصق المتتابع." } },
        "de": { "stringUnit": { "state": "translated", "value": "Das bewegliche HUD erscheint automatisch nach dem sequenziellen Einsetzen." } },
        "en": { "stringUnit": { "state": "translated", "value": "The movable HUD appears automatically after sequential paste." } },
