    "settings.retention.expiration.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تنتهي صلاحية المقتطفات المثبتة بمرور الوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Ausschnitte laufen nicht nach Zeit ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned snippets don’t expire by age."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fragmentos fijados no caducan por antigüedad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits épinglés n’expirent pas avec le temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定スニペットは時間が経っても期限切れになりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 스니펫은 시간이 지나도 만료되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trechos fixados não expiram com o tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённые фрагменты не удаляются по сроку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定片段不会按时间过期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定片段不會依時間過期。"
          }
        }
      }
    },
