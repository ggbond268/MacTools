    "settings.privacyOverview.section": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "الخصوصية والتخزين" } },
        "de": { "stringUnit": { "state": "translated", "value": "Datenschutz & Speicher" } },
        "en": { "stringUnit": { "state": "translated", "value": "Privacy & Storage" } },
        "es": { "stringUnit": { "state": "translated", "value": "Privacidad y almacenamiento" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Confidentialité et stockage" } },
        "ja": { "stringUnit": { "state": "translated", "value": "プライバシーとストレージ" } },
        "ko": { "stringUnit": { "state": "translated", "value": "개인정보 보호 및 저장 공간" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Privacidade e armazenamento" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Конфиденциальность и хранилище" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "隐私与存储" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "隱私權與儲存空間" } }
      }
    },
    "settings.privacyOverview.summary": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تبقى بيانات الحافظة مشفّرة على هذا الـ Mac؛ تخزّن سلسلة المفاتيح المفتاح فقط. تتيح تسهيلات الاستخدام اللصق والنسخ الخاص وتوسيع الكلمات المفتاحية الاختياري." } },
        "de": { "stringUnit": { "state": "translated", "value": "Zwischenablagedaten bleiben auf diesem Mac verschlüsselt; der Schlüsselbund speichert nur den Schlüssel. Bedienungshilfen ermöglichen Einfügen, privates Kopieren und optionale Schlüsselworterweiterung." } },
        "en": { "stringUnit": { "state": "translated", "value": "Clipboard data stays encrypted on this Mac; Keychain stores only the key. Accessibility enables pasting, private copy, and optional keyword expansion." } },
        "es": { "stringUnit": { "state": "translated", "value": "Los datos del portapapeles permanecen cifrados en este Mac; el llavero solo guarda la clave. Accesibilidad permite pegar, copiar en privado y expandir palabras clave de forma opcional." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les données du presse-papiers restent chiffrées sur ce Mac ; le trousseau ne conserve que la clé. Accessibilité permet le collage, la copie privée et l’expansion facultative des mots-clés." } },
        "ja": { "stringUnit": { "state": "translated", "value": "クリップボードデータはこのMac上で暗号化され、キーチェーンにはキーのみを保存します。アクセシビリティは貼り付け、プライベートコピー、任意のキーワード展開に使用します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "클립보드 데이터는 이 Mac에서 암호화되며 키체인에는 키만 저장됩니다. 손쉬운 사용은 붙여넣기, 비공개 복사 및 선택적 키워드 확장에 사용됩니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Os dados da área de transferência ficam encriptados neste Mac; o Porta-chaves guarda apenas a chave. A Acessibilidade permite colar, copiar em privado e expandir palavras-chave opcionalmente." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Данные буфера обмена хранятся зашифрованными на этом Mac; Связка ключей хранит только ключ. Универсальный доступ нужен для вставки, приватного копирования и необязательной подстановки ключевых слов." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "剪贴板数据在本机加密，钥匙串只保存密钥。辅助功能用于粘贴、私密复制及可选的关键词展开。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "剪貼簿資料在本機加密，鑰匙圈只儲存金鑰。輔助使用用於貼上、私密複製及選用的關鍵字展開。" } }
      }
    },
    "settings.storage.status.preparing": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "جارٍ الإعداد" } },
        "de": { "stringUnit": { "state": "translated", "value": "Wird vorbereitet" } },
        "en": { "stringUnit": { "state": "translated", "value": "Preparing" } },
