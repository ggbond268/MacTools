        "zh-Hant": { "stringUnit": { "state": "translated", "value": "選取所有可見項目" } },
        "ja": { "stringUnit": { "state": "translated", "value": "表示中の項目をすべて選択" } },
        "ko": { "stringUnit": { "state": "translated", "value": "표시된 항목 모두 선택" } },
