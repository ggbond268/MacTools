    "setup.open.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في «الاختصارات الأساسية» أدناه، عيّن اختصارًا لسجل الحافظة؛ اضغطه مرة أخرى لإغلاق اللوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weise unten unter „Wichtige Kurzbefehle“ dem Verlauf einen Kurzbefehl zu; erneutes Drücken schließt ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Primary Shortcuts below, assign a shortcut to Clipboard History; press it again to close the panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Atajos principales», asigna un atajo al historial; púlsalo de nuevo para cerrar el panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans « Raccourcis principaux », assignez un raccourci à l’historique ; appuyez à nouveau pour fermer le panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の「主要なショートカット」で履歴にショートカットを割り当てます。もう一度押すとパネルが閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 ‘주요 단축키’에서 기록 단축키를 지정하세요. 다시 누르면 패널이 닫힙니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em “Atalhos principais”, atribua um atalho ao histórico; pressione-o novamente para fechar o painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Основные сочетания клавиш» назначьте сочетание для истории; повторное нажатие закроет панель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方“主要快捷键”中设置常用快捷键；再次按下即可关闭历史面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方「主要快速鍵」中設定常用快速鍵；再次按下即可關閉記錄面板。"
          }
        }
      }
    },
    "setup.privacy.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار طريقة نسخ للمحتوى الحساس"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsweise für sensible Kopien wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Sensitive-Copy Workflow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir un método de copia sensible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une méthode de copie sensible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密コピーの方法を選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 콘텐츠 복사 방식 선택"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher um fluxo para cópias confidenciais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите способ копирования конфиденциальных данных"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择私密复制方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇私密複製方式"
          }
        }
      }
    },
    "setup.privacy.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسخ «نسخ خاص الآن» بخطوة واحدة؛ وينتظر «تجاهل النسخة التالية» نسخة لاحقة من القائمة السياقية. تم تعيين %d من 2 من الاختصارات الاختيارية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jetzt privat kopieren“ kopiert in einem Schritt. „Nächste Kopie ignorieren“ wartet auf ein späteres Kopieren per Kontextmenü. %d von 2 optionalen Kurzbefehlen eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Private Copy Now” copies in one step; “Ignore Next Copy” waits for a later context-menu copy. %d of 2 optional shortcuts assigned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Copia privada ahora» copia en un paso; «Ignorar la próxima copia» espera una copia posterior desde el menú contextual. %d de 2 atajos opcionales asignados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Copier en privé maintenant » copie en une étape ; « Ignorer la prochaine copie » attend une copie ultérieure via le menu contextuel. %d raccourcis facultatifs définis sur 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今すぐプライベートコピー」は1ステップでコピーし、「次のコピーを無視」は後のコンテキストメニューからのコピーを待ちます。任意のショートカットは2個中%d個設定済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘지금 비공개 복사’는 한 번에 복사하고, ‘다음 복사 무시’는 이후의 컨텍스트 메뉴 복사를 기다립니다. 선택 단축키 2개 중 %d개가 설정되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Copiar em privado agora” copia em uma etapa; “Ignorar próxima cópia” aguarda uma cópia posterior pelo menu de contexto. %d de 2 atalhos opcionais definidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скопировать приватно сейчас» копирует за один шаг, а «Игнорировать следующее копирование» ожидает последующее копирование через контекстное меню. Назначено необязательных сочетаний: %d из 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“立即私密复制”一步完成；“忽略下一次复制”用于之后的右键复制。已设置 %d/2 个可选快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「立即私密複製」一步完成；「忽略下一次複製」用於之後的右鍵複製。已設定 %d/2 個可選快速鍵。"
          }
        }
      }
    },
