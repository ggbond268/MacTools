{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "settings.snippets.advanced": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Advanced" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "高级" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "進階" } },
        "ja": { "stringUnit": { "state": "translated", "value": "詳細設定" } },
        "ko": { "stringUnit": { "state": "translated", "value": "고급" } },
        "de": { "stringUnit": { "state": "translated", "value": "Erweitert" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Avancé" } },
        "es": { "stringUnit": { "state": "translated", "value": "Avanzado" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Avançado" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Дополнительно" } },
        "ar": { "stringUnit": { "state": "translated", "value": "متقدم" } }
      }
    },
    "settings.snippets.expandedLimit.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Expanded Text Limit" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "展开文本上限" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "展開文字上限" } },
        "ja": { "stringUnit": { "state": "translated", "value": "展開後のテキスト上限" } },
        "ko": { "stringUnit": { "state": "translated", "value": "확장된 텍스트 제한" } },
        "de": { "stringUnit": { "state": "translated", "value": "Limit für erweiterten Text" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Limite du texte développé" } },
        "es": { "stringUnit": { "state": "translated", "value": "Límite del texto expandido" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Limite do texto expandido" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Лимит развёрнутого текста" } },
        "ar": { "stringUnit": { "state": "translated", "value": "حد النص الموسّع" } }
      }
    },
    "settings.snippets.expandedLimit.description": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Limits the final text after variables expand, including previews. Oversized output is rejected, never truncated." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "限制变量展开后的最终文本，包括预览。超限时会提示错误，不会截断文本。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "限制變數展開後的最終文字，包括預覽。超限時會提示錯誤，不會截斷文字。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "プレビューを含む変数展開後のテキストを制限します。上限を超えるとエラーになり、切り詰めは行いません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "미리보기를 포함해 변수 확장 후 최종 텍스트를 제한합니다. 한도를 넘으면 거부하며 텍스트를 자르지 않습니다." } },
        "de": { "stringUnit": { "state": "translated", "value": "Begrenzt den Text nach dem Ersetzen von Variablen, einschließlich Vorschauen. Zu große Ausgaben werden abgelehnt, nie abgeschnitten." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Limite le texte après le développement des variables, aperçus compris. Un résultat trop long est refusé, jamais tronqué." } },
        "es": { "stringUnit": { "state": "translated", "value": "Limita el texto final tras expandir las variables, incluidas las vistas previas. Si supera el límite, se rechaza sin truncarlo." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Limita o texto após expandir as variáveis, incluindo prévias. Resultados acima do limite são rejeitados, nunca truncados." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ограничивает текст после подстановки переменных, включая предпросмотр. Превышение лимита вызывает ошибку, текст не обрезается." } },
        "ar": { "stringUnit": { "state": "translated", "value": "يحد النص النهائي بعد توسيع المتغيرات، بما في ذلك المعاينات. يُرفض الناتج الذي يتجاوز الحد ولا يُقتطع." } }
      }
    },
    "saved.error.expandedTextTooLarge": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Expanded text exceeds the %lld MB limit. Change it in Snippets → Advanced." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "展开文本超过 %lld MB 上限。可在「片段 → 高级」中调整。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "展開文字超過 %lld MB 上限。可在「片段 → 進階」中調整。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "展開後のテキストが %lld MB の上限を超えています。「スニペット → 詳細設定」で変更できます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "확장된 텍스트가 %lld MB 한도를 초과합니다. 스니펫 → 고급에서 변경하세요." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der erweiterte Text überschreitet das Limit von %lld MB. Ändere es unter Textbausteine → Erweitert." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le texte développé dépasse la limite de %lld Mo. Modifiez-la dans Extraits → Avancé." } },
        "es": { "stringUnit": { "state": "translated", "value": "El texto expandido supera el límite de %lld MB. Cámbialo en Fragmentos → Avanzado." } },
        "pt": { "stringUnit": { "state": "translated", "value": "O texto expandido excede o limite de %lld MB. Altere em Trechos → Avançado." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Развёрнутый текст превышает лимит %lld МБ. Измените его в разделе «Фрагменты → Дополнительно»." } },
        "ar": { "stringUnit": { "state": "translated", "value": "يتجاوز النص الموسّع حد %lld م.ب. غيّره في المقتطفات ← متقدم." } }
      }
    },
    "saved.error.invalidVariableOptions": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check the variable options, offset, and time zone." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请检查变量选项、偏移量和时区。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請檢查變數選項、偏移量和時區。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "変数のオプション、オフセット、タイムゾーンを確認してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "변수 옵션, 오프셋 및 시간대를 확인하세요." } },
        "de": { "stringUnit": { "state": "translated", "value": "Variablenoptionen, Versatz und Zeitzone prüfen." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Vérifiez les options, le décalage et le fuseau horaire." } },
        "es": { "stringUnit": { "state": "translated", "value": "Comprueba las opciones, el desplazamiento y la zona horaria." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Verifique as opções, o deslocamento e o fuso horário." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Проверьте параметры переменной, смещение и часовой пояс." } },
        "ar": { "stringUnit": { "state": "translated", "value": "تحقق من خيارات المتغير والإزاحة والمنطقة الزمنية." } }
      }
    },
