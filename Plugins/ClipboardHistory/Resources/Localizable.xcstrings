    "settings.retention.itemLimit.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُحفظ المحتوى المضمّن الذي يتجاوز الحد. تُحفظ الملفات كمراجع فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingebettete Inhalte über dem Limit werden nicht gespeichert. Dateien werden nur als Verweise gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embedded content over the limit won’t be saved. Files are stored as references only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido integrado que supere el límite no se guardará. Los archivos solo se guardan como referencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu intégré dépassant la limite ne sera pas enregistré. Les fichiers sont stockés uniquement comme références."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限を超える埋め込みコンテンツは保存されません。ファイルは参照のみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한을 초과한 내장 콘텐츠는 저장되지 않습니다. 파일은 참조로만 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo incorporado acima do limite não será salvo. Os arquivos são armazenados apenas como referências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенное содержимое сверх лимита не сохраняется. Файлы хранятся только как ссылки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过上限的内嵌内容不会保存；文件仅保存引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過上限的內嵌內容不會儲存；檔案僅儲存參照。"
          }
        }
      }
    },
