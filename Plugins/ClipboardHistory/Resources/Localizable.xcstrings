        "ja": { "stringUnit": { "state": "translated", "value": "移動可能なHUDは順番にペーストした後に自動的に表示されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이동 가능한 HUD는 순차 붙여넣기 후 자동으로 나타납니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "O HUD móvel aparece automaticamente após colar em sequência." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Перемещаемый HUD появляется автоматически после последовательной вставки." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "可移动 HUD 会在连续粘贴后自动出现。" } },
