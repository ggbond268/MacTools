        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 로컬 저장 공간을 준비하는 중…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando o armazenamento local criptografado…"
