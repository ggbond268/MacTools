    "settings.retention.maximum.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند بلوغ حد العناصر، تُزال أقدم عناصر السجل تلقائيًا. ولا تتأثر العناصر المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erreichen der Eintragsgrenze wird der älteste Verlauf automatisch entfernt. Gespeicherte Elemente bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the item limit is reached, the oldest History items are removed automatically. Saved items are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al alcanzar el límite de elementos, se elimina automáticamente el historial más antiguo. Los elementos guardados no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque la limite est atteinte, l’historique le plus ancien est supprimé automatiquement. Les éléments enregistrés ne sont pas affectés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目数の上限に達すると、最も古い履歴が自動的に削除されます。保存済み項目には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 수 한도에 도달하면 가장 오래된 기록이 자동으로 삭제됩니다. 저장된 항목에는 영향을 주지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao atingir o limite de itens, o histórico mais antigo é removido automaticamente. Os itens salvos não são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При достижении лимита самая старая история удаляется автоматически. Сохранённые элементы не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到条数上限时，会自动移除最早的历史。已存项目不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到筆數上限時，會自動移除最早的記錄。已儲存項目不受影響。"
          }
        }
      }
    },
    "settings.retention.storageLimit.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند بلوغ حد السعة، تُزال أقدم عناصر السجل. ولا تتأثر العناصر المحفوظة، ويظل التخزين مقيدًا بمساحة القرص المتاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erreichen des Speicherlimits wird der älteste Verlauf entfernt. Gespeicherte Elemente bleiben erhalten; der Speicher hängt vom freien Speicherplatz ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the storage limit is reached, the oldest History items are removed. Saved items are unaffected; actual storage remains subject to available disk space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al alcanzar el límite, se elimina el historial más antiguo. Los elementos guardados no se ven afectados; el almacenamiento depende del espacio disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque la limite est atteinte, l’historique le plus ancien est supprimé. Les éléments enregistrés ne sont pas affectés ; le stockage dépend de l’espace disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存容量の上限に達すると、最も古い履歴が削除されます。保存済み項目には影響せず、実際の容量は空きディスク容量にも左右されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 용량 한도에 도달하면 가장 오래된 기록이 삭제됩니다. 저장된 항목에는 영향을 주지 않으며 실제 용량은 디스크 여유 공간의 제한을 받습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao atingir o limite, o histórico mais antigo é removido. Os itens salvos não são afetados; o armazenamento depende do espaço disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При достижении лимита удаляется самая старая история. Сохранённые элементы не затрагиваются; объём зависит от свободного места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到容量上限时会移除最早的历史。已存项目不受影响；实际保存仍受可用磁盘空间限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到容量上限時會移除最早的記錄。已儲存項目不受影響；實際儲存仍受可用磁碟空間限制。"
          }
        }
      }
    },
