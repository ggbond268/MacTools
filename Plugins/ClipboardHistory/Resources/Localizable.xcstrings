    "settings.storage.encrypted.title": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تخزين محلي مشفّر" } },
        "de": { "stringUnit": { "state": "translated", "value": "Verschlüsselter lokaler Speicher" } },
        "en": { "stringUnit": { "state": "translated", "value": "Encrypted Local Storage" } },
        "es": { "stringUnit": { "state": "translated", "value": "Almacenamiento local cifrado" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Stockage local chiffré" } },
        "ja": { "stringUnit": { "state": "translated", "value": "暗号化ローカルストレージ" } },
        "ko": { "stringUnit": { "state": "translated", "value": "암호화된 로컬 저장 공간" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Armazenamento local criptografado" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Локальное зашифрованное хранилище" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "本机加密存储" } },
