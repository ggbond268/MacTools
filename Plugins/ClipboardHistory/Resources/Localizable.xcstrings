        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重试" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "重試" } }
      }
    },
    "settings.storage.resetUnreadable": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "حذف بيانات الحافظة غير القابلة للقراءة…" } },
        "de": { "stringUnit": { "state": "translated", "value": "Nicht lesbare Zwischenablagedaten löschen …" } },
        "en": { "stringUnit": { "state": "translated", "value": "Delete Unreadable Clipboard Data…" } },
        "es": { "stringUnit": { "state": "translated", "value": "Eliminar datos ilegibles del portapapeles…" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprimer les données illisibles du presse-papiers…" } },
        "ja": { "stringUnit": { "state": "translated", "value": "読み取れないクリップボードデータを削除…" } },
        "ko": { "stringUnit": { "state": "translated", "value": "읽을 수 없는 클립보드 데이터 삭제…" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Apagar dados ilegíveis da área de transferência…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить нечитаемые данные буфера обмена…" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除无法读取的剪贴板数据…" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "刪除無法讀取的剪貼簿資料…" } }
      }
    },
    "settings.storage.reset.title": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "حذف بيانات الحافظة غير القابلة للقراءة؟" } },
        "de": { "stringUnit": { "state": "translated", "value": "Nicht lesbare Zwischenablagedaten löschen?" } },
        "en": { "stringUnit": { "state": "translated", "value": "Delete Unreadable Clipboard Data?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Eliminar los datos ilegibles del portapapeles?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprimer les données illisibles du presse-papiers ?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "読み取れないクリップボードデータを削除しますか？" } },
        "ko": { "stringUnit": { "state": "translated", "value": "읽을 수 없는 클립보드 데이터를 삭제할까요?" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Apagar os dados ilegíveis da área de transferência?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить нечитаемые данные буфера обмена?" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除无法读取的剪贴板数据？" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "刪除無法讀取的剪貼簿資料？" } }
      }
    },
    "settings.storage.reset.message": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "سيؤدي هذا إلى حذف قاعدة بيانات الحافظة المشفّرة ومفتاحها من سلسلة المفاتيح. لا يمكن استعادة السجل أو المقاطع المحفوظة أو المقتطفات." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dadurch werden die verschlüsselte Zwischenablagedatenbank und ihr Schlüsselbundschlüssel gelöscht. Verlauf, gespeicherte Clips und Textbausteine können nicht wiederhergestellt werden." } },
        "en": { "stringUnit": { "state": "translated", "value": "This deletes the encrypted Clipboard database and its Keychain key. History, Saved clips, and snippets cannot be recovered." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esto elimina la base de datos cifrada del portapapeles y su clave del Llavero. El historial, los clips guardados y los fragmentos no se podrán recuperar." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cette opération supprime la base chiffrée du presse-papiers et sa clé du trousseau. L’historique, les clips enregistrés et les extraits ne pourront pas être récupérés." } },
        "ja": { "stringUnit": { "state": "translated", "value": "暗号化されたクリップボードデータベースとキーチェーン内のキーが削除されます。履歴、保存済みクリップ、スニペットは復元できません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "암호화된 클립보드 데이터베이스와 키체인 키가 삭제됩니다. 기록, 저장된 클립 및 스니펫은 복구할 수 없습니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Isto apaga o banco de dados criptografado da área de transferência e a respectiva chave nas Chaves. O histórico, os clipes salvos e os snippets não poderão ser recuperados." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Зашифрованная база буфера обмена и её ключ в Связке ключей будут удалены. Историю, сохранённые фрагменты и сниппеты восстановить нельзя." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这会删除加密的剪贴板数据库及其钥匙串密钥。历史、已保存片段和文本片段都将无法恢复。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這會刪除加密的剪貼簿資料庫及其鑰匙圈金鑰。記錄、已儲存片段和文字片段都將無法復原。" } }
      }
    },
    "settings.storage.reset.confirm": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "الحذف والبدء من جديد" } },
        "de": { "stringUnit": { "state": "translated", "value": "Löschen und neu beginnen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Delete and Start Over" } },
        "es": { "stringUnit": { "state": "translated", "value": "Eliminar y empezar de nuevo" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprimer et recommencer" } },
        "ja": { "stringUnit": { "state": "translated", "value": "削除してやり直す" } },
        "ko": { "stringUnit": { "state": "translated", "value": "삭제하고 다시 시작" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Apagar e recomeçar" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить и начать заново" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除并重新开始" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "刪除並重新開始" } }
      }
    },
    "settings.storage.recovery.keychain": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "إذا عرض macOS مطالبة، فاسمح لـ MacTools بالوصول إلى سلسلة المفاتيح المحلية ثم أعد المحاولة. لم يُحذف السجل الحالي." } },
        "de": { "stringUnit": { "state": "translated", "value": "Erlaube MacTools bei einer macOS-Abfrage den Zugriff auf den lokalen Schlüsselbund und versuche es erneut. Der vorhandene Verlauf wurde nicht gelöscht." } },
        "en": { "stringUnit": { "state": "translated", "value": "If macOS prompts, allow MacTools to access the local Keychain, then retry. Existing history has not been deleted." } },
        "es": { "stringUnit": { "state": "translated", "value": "Si macOS lo solicita, permite que MacTools acceda al Llavero local y vuelve a intentarlo. El historial existente no se ha eliminado." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Si macOS vous le demande, autorisez MacTools à accéder au trousseau local, puis réessayez. L’historique existant n’a pas été supprimé." } },
        "ja": { "stringUnit": { "state": "translated", "value": "macOSに求められた場合はMacToolsによるローカルキーチェーンへのアクセスを許可してから再試行してください。既存の履歴は削除されていません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "macOS에 메시지가 표시되면 MacTools의 로컬 키체인 접근을 허용한 다음 다시 시도하세요. 기존 기록은 삭제되지 않았습니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Se o macOS pedir, permita que o MacTools acesse as Chaves locais e tente novamente. O histórico existente não foi apagado." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Если macOS запросит доступ, разрешите MacTools использовать локальную Связку ключей и повторите попытку. Существующая история не удалена." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "如 macOS 显示提示，请允许 MacTools 访问本机钥匙串，然后重试。现有历史记录尚未删除。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "若 macOS 顯示提示，請允許 MacTools 存取本機鑰匙圈，然後重試。現有記錄尚未刪除。" } }
      }
    },
    "settings.storage.recovery.missingKey": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "لا يمكن قراءة قاعدة البيانات الحالية إلا بالمفتاح الأصلي. حاول استعادة المفتاح أولًا؛ ولا تحذف السجل غير القابل للقراءة وتبدأ من جديد إلا بعد التأكد من تعذر استعادته." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die vorhandene Datenbank kann nur mit dem ursprünglichen Schlüssel gelesen werden. Versuche zuerst, den Schlüssel wiederherzustellen; lösche den unlesbaren Verlauf erst, wenn das nicht möglich ist." } },
        "en": { "stringUnit": { "state": "translated", "value": "The existing database can be read only with its original key. Try to restore that key first; delete the unreadable history and start over only after confirming it cannot be recovered." } },
        "es": { "stringUnit": { "state": "translated", "value": "La base de datos existente solo se puede leer con su clave original. Intenta recuperarla primero; elimina el historial ilegible y empieza de nuevo solo si confirmas que no puede recuperarse." } },
        "fr": { "stringUnit": { "state": "translated", "value": "La base existante ne peut être lue qu’avec sa clé d’origine. Essayez d’abord de restaurer cette clé ; ne supprimez l’historique illisible qu’après avoir confirmé qu’elle est irrécupérable." } },
        "ja": { "stringUnit": { "state": "translated", "value": "既存のデータベースは元のキーでのみ読み取れます。まずキーの復元を試し、復元できないことを確認してから読み取れない履歴を削除してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "기존 데이터베이스는 원래 키로만 읽을 수 있습니다. 먼저 키 복원을 시도하고 복구할 수 없음을 확인한 후에만 읽을 수 없는 기록을 삭제하세요." } },
        "pt": { "stringUnit": { "state": "translated", "value": "O banco de dados existente só pode ser lido com a chave original. Tente recuperá-la primeiro; apague o histórico ilegível apenas depois de confirmar que ela não pode ser recuperada." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Существующую базу можно прочитать только с исходным ключом. Сначала попробуйте восстановить ключ; удаляйте нечитаемую историю только после подтверждения, что восстановление невозможно." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "现有数据库只有使用原来的加密密钥才能读取。请先尝试恢复该密钥；确认无法恢复后，才能删除无法读取的历史并重新开始。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "現有資料庫只有使用原來的加密金鑰才能讀取。請先嘗試復原該金鑰；確認無法復原後，才能刪除無法讀取的記錄並重新開始。" } }
      }
    },
    "settings.storage.recovery.unreadable": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تم الاحتفاظ بالبيانات المشفّرة الأصلية. أعد المحاولة أولًا؛ ولا تحذفها إلا بعد التأكد من عدم الحاجة إلى استعادتها." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die ursprünglichen verschlüsselten Daten bleiben erhalten. Versuche es zuerst erneut; lösche sie erst, wenn keine Wiederherstellung mehr nötig ist." } },
        "en": { "stringUnit": { "state": "translated", "value": "The original encrypted data is preserved. Retry first; delete it only after deciding recovery is no longer needed." } },
        "es": { "stringUnit": { "state": "translated", "value": "Los datos cifrados originales se conservan. Vuelve a intentarlo primero; elimínalos solo cuando ya no necesites recuperarlos." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les données chiffrées d’origine sont conservées. Réessayez d’abord ; supprimez-les seulement si aucune récupération n’est nécessaire." } },
        "ja": { "stringUnit": { "state": "translated", "value": "元の暗号化データは保持されています。まず再試行し、復元が不要と判断した場合にのみ削除してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "원본 암호화 데이터는 보존됩니다. 먼저 다시 시도하고 더 이상 복구할 필요가 없을 때만 삭제하세요." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Os dados criptografados originais são preservados. Tente novamente primeiro; apague-os apenas quando a recuperação não for mais necessária." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Исходные зашифрованные данные сохранены. Сначала повторите попытку; удаляйте их только если восстановление больше не нужно." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "原始加密数据已保留。请先重试；确认不再需要恢复时再删除它。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "原始加密資料已保留。請先重試；確認不再需要復原時再刪除。" } }
      }
    },
    "settings.storage.recovery.unavailable": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "عالج مشكلة التخزين المحلي ثم أعد المحاولة. لن يستمر جمع سجل الحافظة حتى تُحل المشكلة." } },
        "de": { "stringUnit": { "state": "translated", "value": "Behebe das lokale Speicherproblem und versuche es erneut. Bis dahin wird kein weiterer Zwischenablageverlauf erfasst." } },
        "en": { "stringUnit": { "state": "translated", "value": "Resolve the local storage issue and retry. Clipboard history collection remains paused until the issue is fixed." } },
        "es": { "stringUnit": { "state": "translated", "value": "Resuelve el problema de almacenamiento local y vuelve a intentarlo. La recopilación permanecerá en pausa hasta que se solucione." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Résolvez le problème de stockage local et réessayez. La collecte reste suspendue jusqu’à la résolution du problème." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ローカルストレージの問題を解決して再試行してください。問題が解決するまで履歴の収集は停止します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "로컬 저장 공간 문제를 해결한 후 다시 시도하세요. 문제가 해결될 때까지 클립보드 기록 수집이 중단됩니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Resolva o problema de armazenamento local e tente novamente. A coleta ficará pausada até o problema ser corrigido." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Устраните проблему локального хранилища и повторите попытку. Сбор истории будет приостановлен до её решения." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "解决本机存储问题后重试。问题解决前，剪贴板历史不会继续收集。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "解決本機儲存問題後重試。問題解決前，剪貼簿記錄不會繼續收集。" } }
      }
    },
