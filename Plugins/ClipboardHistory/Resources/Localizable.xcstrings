    "settings.privacy.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ محتوى السجل في ملف محلي مشفّر، وتحتفظ سلسلة المفاتيح بالمفتاح فقط؛ وتحفظ الملفات كمراجع للمسارات فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlaufsinhalte liegen in einer lokal verschlüsselten Datei; der Schlüsselbund speichert nur den Schlüssel, Dateien nur Pfadreferenzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History content is kept in a locally encrypted file; Keychain stores only the key, and files are saved only as path references."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido del historial se guarda en un archivo local cifrado; el Llavero solo contiene la clave y los archivos se guardan como referencias de ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu de l’historique est conservé dans un fichier local chiffré ; le trousseau ne contient que la clé et les fichiers seulement leur chemin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴の内容は暗号化されたローカルファイルに保存され、キーチェーンにはキーのみ、ファイルはパス参照のみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 콘텐츠는 암호화된 로컬 파일에 저장되고 키체인에는 키만, 파일에는 경로 참조만 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo do histórico fica em um arquivo local criptografado; as Chaves guardam apenas a chave e os arquivos, somente referências de caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое истории хранится в локальном зашифрованном файле; в Связке ключей находится только ключ, а для файлов сохраняются лишь пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史内容保存在本机加密文件中，钥匙串只保存密钥；文件仅保存路径引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄內容儲存在本機加密檔案中，鑰匙圈只儲存金鑰；檔案只儲存路徑參照。"
          }
        }
      }
    },
