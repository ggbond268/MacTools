        "es": { "stringUnit": { "state": "translated", "value": "En el modo de selección múltiple, selecciona todos los elementos visibles sin quitar el foco de la búsqueda." } },
        "fr": { "stringUnit": { "state": "translated", "value": "En mode de sélection multiple, sélectionnez tous les éléments visibles sans quitter la recherche." } },
        "ja": { "stringUnit": { "state": "translated", "value": "複数選択モードで、検索からフォーカスを移さずに表示中の項目をすべて選択します。" } },
