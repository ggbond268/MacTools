    "saved.error.invalidKeyword": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "لا يمكن أن تحتوي الكلمة على مسافات أو فواصل أسطر." } },
        "de": { "stringUnit": { "state": "translated", "value": "Ein Kürzel darf keine Leerzeichen oder Zeilenumbrüche enthalten." } },
        "en": { "stringUnit": { "state": "translated", "value": "A keyword cannot contain spaces or line breaks." } },
        "es": { "stringUnit": { "state": "translated", "value": "Una palabra clave no puede contener espacios ni saltos de línea." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Un mot-clé ne peut pas contenir d’espaces ni de sauts de ligne." } },
        "ja": { "stringUnit": { "state": "translated", "value": "キーワードに空白や改行は使用できません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "키워드에는 공백이나 줄바꿈을 사용할 수 없습니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Uma palavra-chave não pode conter espaços nem quebras de linha." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ключевое слово не может содержать пробелы или переносы строк." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "关键词不能包含空格或换行符。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "關鍵字不能包含空格或換行符號。" } }
      }
    },
    "saved.error.keywordCacheFull": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "لا يمكن أن يتجاوز إجمالي المقتطفات ذات الكلمات المفتاحية %@." } },
        "de": { "stringUnit": { "state": "translated", "value": "Textbausteine mit Kürzel dürfen insgesamt %@ nicht überschreiten." } },
