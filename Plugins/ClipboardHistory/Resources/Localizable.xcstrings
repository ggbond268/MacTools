          }
        }
      }
    },
    "shortcut.ignoreNext.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتم قراءة التغيير التالي في الحافظة أو حفظه، وسيُلغى تلقائيًا بعد 15 ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Änderung der Zwischenablage wird weder gelesen noch gespeichert und nach 15 Sekunden automatisch abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next clipboard change won’t be read or saved and will cancel automatically after 15 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El próximo cambio del portapapeles no se leerá ni guardará y se cancelará automáticamente tras 15 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine modification du presse-papiers ne sera ni lue ni enregistrée et s’annulera automatiquement après 15 secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のクリップボード変更は読み取りも保存もされず、15秒後に自動的に解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 클립보드 변경은 읽거나 저장하지 않으며 15초 후 자동으로 취소됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima alteração da área de transferência não será lida nem salva e será cancelada automaticamente após 15 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее изменение буфера обмена не будет прочитано или сохранено и отменится через 15 секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来一次剪贴板变化不会被读取或保存，15 秒后自动取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來一次剪貼簿變更不會被讀取或儲存，15 秒後自動取消。"
          }
        }
      }
    },
