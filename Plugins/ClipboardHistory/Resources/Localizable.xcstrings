    "error.authenticationFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من سجل الحافظة. تم الاحتفاظ بالبيانات المشفرة الأصلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zwischenablageverlauf konnte nicht authentifiziert werden. Die verschlüsselten Originaldaten wurden beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard history couldn’t be authenticated. The original encrypted data has been preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo autenticar el historial. Se conservaron los datos cifrados originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’authentifier l’historique. Les données chiffrées d’origine ont été conservées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴を検証できませんでした。元の暗号化データは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록을 인증할 수 없습니다. 원본 암호화 데이터는 보존되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível autenticar o histórico. Os dados criptografados originais foram preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подлинность истории. Исходные зашифрованные данные сохранены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证剪贴板历史。原始加密数据已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證剪貼簿記錄。原始加密資料已保留。"
          }
        }
      }
    },
    "error.invalidEncryptionKey": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح تشفير سجل الحافظة غير صالح. توقف جمع السجل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verschlüsselungsschlüssel des Zwischenablageverlaufs ist ungültig. Die Sammlung wurde gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard history encryption key is invalid. History collection has stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de cifrado del historial no es válida. La recopilación se ha detenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de chiffrement de l’historique est invalide. La collecte s’est arrêtée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴の暗号化キーが無効です。履歴の収集を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록 암호화 키가 올바르지 않습니다. 기록 수집이 중지되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de criptografia do histórico é inválida. A coleta foi interrompida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимый ключ шифрования истории. Сбор истории остановлен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板历史的加密密钥无效。历史记录已停止收集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿記錄的加密金鑰無效。記錄收集已停止。"
          }
        }
      }
    },
    "error.invalidEnvelope": {
      "localizations": {
