    "settings.snippets.clear.confirm": {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"حذف المقتطفات"}},"de":{"stringUnit":{"state":"translated","value":"Textbausteine löschen"}},"en":{"stringUnit":{"state":"translated","value":"Delete Snippets"}},"es":{"stringUnit":{"state":"translated","value":"Eliminar fragmentos"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer les extraits"}},"ja":{"stringUnit":{"state":"translated","value":"スニペットを削除"}},"ko":{"stringUnit":{"state":"translated","value":"스니펫 삭제"}},"pt":{"stringUnit":{"state":"translated","value":"Apagar trechos"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить фрагменты"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除片段"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"刪除片段"}}}},
    "settings.snippets.clear.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Permanently deletes all snippets and their keywords. History and Saved clips are kept. This cannot be undone." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "永久删除所有片段及其关键词。历史和已存剪辑会保留。此操作无法撤销。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "永久刪除所有片段及其關鍵字。記錄和已儲存剪輯會保留。此操作無法復原。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "すべてのスニペットとキーワードを完全に削除します。履歴と保存済みクリップは保持されます。この操作は取り消せません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "모든 스니펫과 키워드를 영구 삭제합니다. 기록과 저장한 클립은 유지됩니다. 이 작업은 되돌릴 수 없습니다." } },
        "de": { "stringUnit": { "state": "translated", "value": "Löscht alle Textbausteine und ihre Kürzel dauerhaft. Verlauf und gespeicherte Clips bleiben erhalten. Dies kann nicht rückgängig gemacht werden." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprime définitivement tous les extraits et leurs mots-clés. L’historique et les clips enregistrés sont conservés. Cette action est irréversible." } },
        "es": { "stringUnit": { "state": "translated", "value": "Elimina permanentemente todos los fragmentos y sus palabras clave. El historial y los clips guardados se conservan. Esta acción no se puede deshacer." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Apaga permanentemente todos os trechos e suas palavras-chave. O histórico e os clipes salvos são mantidos. Esta ação não pode ser desfeita." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Безвозвратно удаляет все фрагменты и их ключевые слова. История и сохранённые клипы остаются. Это действие нельзя отменить." } },
        "ar": { "stringUnit": { "state": "translated", "value": "يحذف نهائيًا جميع المقتطفات وكلماتها المفتاحية. يبقى السجل والقصاصات المحفوظة. لا يمكن التراجع عن هذا الإجراء." } }
      }
    },
    "settings.snippets.clear.title": {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"حذف كل المقتطفات؟"}},"de":{"stringUnit":{"state":"translated","value":"Alle Textbausteine löschen?"}},"en":{"stringUnit":{"state":"translated","value":"Delete All Snippets?"}},"es":{"stringUnit":{"state":"translated","value":"¿Eliminar todos los fragmentos?"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer tous les extraits ?"}},"ja":{"stringUnit":{"state":"translated","value":"すべてのスニペットを削除しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"모든 스니펫을 삭제할까요?"}},"pt":{"stringUnit":{"state":"translated","value":"Apagar todos os trechos?"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить все фрагменты?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除所有片段？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"刪除所有片段？"}}}},
    "settings.snippets.count": {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"%d مقتطفات"}},"de":{"stringUnit":{"state":"translated","value":"%d Textbausteine"}},"en":{"stringUnit":{"state":"translated","value":"%d snippets"}},"es":{"stringUnit":{"state":"translated","value":"%d fragmentos"}},"fr":{"stringUnit":{"state":"translated","value":"%d extraits"}},"ja":{"stringUnit":{"state":"translated","value":"%d 個のスニペット"}},"ko":{"stringUnit":{"state":"translated","value":"스니펫 %d개"}},"pt":{"stringUnit":{"state":"translated","value":"%d trechos"}},"ru":{"stringUnit":{"state":"translated","value":"Фрагментов: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 个片段"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%d 個片段"}}}},
    "settings.snippets.description": {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"قوالب قابلة لإعادة الاستخدام مع كلمات وتوسيمات ومتغيرات وقت اللصق."}},"de":{"stringUnit":{"state":"translated","value":"Wiederverwendbare Vorlagen mit optionalen Kürzeln, Tags und Variablen beim Einsetzen."}},"en":{"stringUnit":{"state":"translated","value":"Reusable editable templates with optional keywords, tags, and paste-time variables."}},"es":{"stringUnit":{"state":"translated","value":"Plantillas editables reutilizables con palabras clave, etiquetas y variables al pegar."}},"fr":{"stringUnit":{"state":"translated","value":"Modèles modifiables réutilisables avec mots-clés, tags et variables au collage."}},"ja":{"stringUnit":{"state":"translated","value":"キーワード、タグ、ペースト時変数に対応した再利用可能な編集用テンプレートです。"}},"ko":{"stringUnit":{"state":"translated","value":"키워드, 태그, 붙여넣기 시점 변수를 지원하는 재사용 가능한 편집 템플릿입니다."}},"pt":{"stringUnit":{"state":"translated","value":"Modelos editáveis reutilizáveis com palavras-chave, etiquetas e variáveis ao colar."}},"ru":{"stringUnit":{"state":"translated","value":"Редактируемые шаблоны с ключевыми словами, тегами и переменными при вставке."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可复用的可编辑模板，支持可选关键词、标签和粘贴时变量。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可重複使用的可編輯範本，支援選用關鍵字、標籤與貼上時變數。"}}}},
    "snippet.createFromClip": {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"إنشاء مقتطف من النسخة…"}},"de":{"stringUnit":{"state":"translated","value":"Textbaustein aus Clip erstellen…"}},"en":{"stringUnit":{"state":"translated","value":"Create Snippet from Clip…"}},"es":{"stringUnit":{"state":"translated","value":"Crear fragmento desde el clip…"}},"fr":{"stringUnit":{"state":"translated","value":"Créer un extrait depuis le clip…"}},"ja":{"stringUnit":{"state":"translated","value":"クリップからスニペットを作成…"}},"ko":{"stringUnit":{"state":"translated","value":"클립에서 스니펫 생성…"}},"pt":{"stringUnit":{"state":"translated","value":"Criar trecho do clipe…"}},"ru":{"stringUnit":{"state":"translated","value":"Создать фрагмент из клипа…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从片段创建文本片段…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"從剪輯建立片段…"}}}}
