    "shortcut.pastePlain.groupDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم اختصارًا واحدًا للصق نص عادي أو النص المتعرّف عليه في الصورة الحالية دون فتح سجل الحافظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kurzbefehl fügt Klartext oder erkannten Text aus dem aktuellen Bild ein, ohne den Verlauf zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one shortcut to paste plain text or recognized text from the current image without opening Clipboard History."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un atajo para pegar texto sin formato o el texto reconocido de la imagen actual sin abrir el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un raccourci pour coller du texte brut ou le texte reconnu dans l’image actuelle sans ouvrir l’historique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を開かずに、標準テキストまたは現在の画像で認識された文字を1つのショートカットでペーストします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 열지 않고 하나의 단축키로 일반 텍스트 또는 현재 이미지에서 인식된 텍스트를 붙여넣습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um atalho para colar texto simples ou o texto reconhecido na imagem atual sem abrir o histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одним сочетанием вставляйте обычный текст или распознанный текст текущего изображения, не открывая историю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一个快捷键直接粘贴无格式文本或当前图片中已识别的文字，无需打开剪贴板历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用一個快速鍵直接貼上無格式文字或目前圖片中已辨識的文字，無需開啟剪貼簿記錄。"
          }
        }
      }
    },
