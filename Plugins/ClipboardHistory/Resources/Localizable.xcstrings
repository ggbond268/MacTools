    "settings.shortcuts.primary.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض سجل الحافظة أو أخفه بالاختصار، أو الصق نصًا عاديًا يتضمن النص المتعرّف عليه في الصورة الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende den Zwischenablageverlauf per Kurzbefehl ein oder aus, oder füge Klartext einschließlich erkanntem Text aus dem aktuellen Bild ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show or hide Clipboard History with its shortcut, or paste plain text including recognized text from the current image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta el historial con su atajo, o pega texto sin formato, incluido el texto reconocido de la imagen actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez ou masquez l’historique avec son raccourci, ou collez du texte brut, y compris le texte reconnu dans l’image actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットで履歴を表示または非表示にするか、現在の画像で認識された文字を含む標準テキストをペーストします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키로 기록을 표시하거나 숨기고, 현재 이미지에서 인식된 텍스트를 포함한 일반 텍스트를 붙여넣습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre ou oculte o histórico com o atalho, ou cole texto simples, incluindo o texto reconhecido na imagem atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывайте или скрывайте историю сочетанием клавиш либо вставляйте обычный текст, включая распознанный текст текущего изображения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用快捷键显示或隐藏剪贴板历史，或直接粘贴纯文本和当前图片中已识别的文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用快速鍵顯示或隱藏剪貼簿記錄，或直接貼上純文字和目前圖片中已辨識的文字。"
          }
        }
      }
    },
