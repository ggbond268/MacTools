    "queue.explicit.retentionNotice": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تحتفظ قائمة اللصق الصريحة النشطة بنسخها المشفرة حتى تنتهي القائمة أو يتم إلغاؤها." } },
        "de": { "stringUnit": { "state": "translated", "value": "Eine aktive explizite Einfügewarteschlange behält ihre verschlüsselten Kopien, bis sie beendet oder abgebrochen wird." } },
        "en": { "stringUnit": { "state": "translated", "value": "An active explicit paste queue keeps its encrypted copies until the queue finishes or is canceled." } },
        "es": { "stringUnit": { "state": "translated", "value": "Una cola de pegado explícita activa conserva sus copias cifradas hasta que termine o se cancele." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Une file de collage explicite active conserve ses copies chiffrées jusqu’à sa fin ou son annulation." } },
        "ja": { "stringUnit": { "state": "translated", "value": "明示的なペーストキューが有効な間、完了またはキャンセルまで暗号化されたコピーが保持されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "활성 명시적 붙여넣기 대기열은 완료되거나 취소될 때까지 암호화된 복사본을 유지합니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Uma fila de colagem explícita ativa mantém suas cópias criptografadas até terminar ou ser cancelada." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Активная явная очередь вставки хранит зашифрованные копии до завершения или отмены очереди." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "活动的显式粘贴队列会保留加密副本，直到队列完成或取消。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "使用中的明確貼上佇列會保留加密副本，直到佇列完成或取消。" } }
      }
    },
