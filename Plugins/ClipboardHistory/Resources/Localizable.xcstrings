    "action.pause.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف حفظ عناصر الحافظة التي تنسخها لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern künftig kopierter Zwischenablageinhalte pausieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause saving clipboard items copied from now on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de guardar los elementos del portapapeles que copies después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspend l’enregistrement des éléments copiés par la suite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以降にコピーするクリップボード項目の保存を停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후에 복사한 클립보드 항목 저장을 일시 정지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe o salvamento dos itens copiados depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановить сохранение последующих элементов буфера обмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停保存之后复制的剪贴板项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停儲存之後複製的剪貼簿項目。"
          }
        }
      }
    },
    "action.resume.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استأنف حفظ عناصر الحافظة التي تنسخها لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern künftig kopierter Zwischenablageinhalte fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume saving clipboard items copied from now on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a guardar los elementos del portapapeles que copies después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend l’enregistrement des éléments copiés par la suite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以降にコピーするクリップボード項目の保存を再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후에 복사한 클립보드 항목 저장을 재개합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma o salvamento dos itens copiados depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновить сохранение последующих элементов буфера обмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复保存之后复制的剪贴板项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復儲存之後複製的剪貼簿項目。"
          }
        }
      }
    },
    "panel.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ شيئًا للبحث عنه وإعادة استخدامه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere etwas, um es hier zu suchen und wiederzuverwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy something to search and reuse it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia algo para buscarlo y volver a usarlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez un élément pour le rechercher et le réutiliser ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かをコピーすると、ここで検索して再利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무언가를 복사하면 여기에서 검색하고 다시 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie algo para pesquisar e reutilizar aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте что-нибудь, чтобы найти и использовать это здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制内容后，可在这里搜索并再次使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製內容後，可在這裡搜尋並再次使用。"
          }
        }
      }
    },
    "panel.empty.paused.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الاستئناف، ستُحفظ عناصر الحافظة الجديدة على هذا الـ Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Fortsetzen werden neu kopierte Elemente auf diesem Mac gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After resuming, newly copied clipboard items will be saved on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reanudar, los nuevos elementos copiados se guardarán en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la reprise, les nouveaux éléments copiés seront enregistrés sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開すると、新しくコピーした項目がこのMacに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개하면 새로 복사한 항목이 이 Mac에 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após retomar, os novos itens copiados serão salvos neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После возобновления новые элементы буфера обмена будут сохраняться на этом Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复后，新复制的剪贴板项目会保存在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復後，新複製的剪貼簿項目會儲存在此 Mac。"
          }
        }
      }
    },
