    "shortcut.pastePlain.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلصق الحافظة كنص عادي دون فتح السجل، ويستخدم النص المتعرّف عليه عندما تكون الحافظة صورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt die Zwischenablage ohne Verlauf als Klartext ein und verwendet bei einem Bild den bereits erkannten Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastes the clipboard as plain text without opening history, using recognized text when the clipboard contains an image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el portapapeles como texto sin formato sin abrir el historial y usa el texto reconocido si contiene una imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colle le presse-papiers en texte brut sans ouvrir l’historique et utilise le texte reconnu s’il contient une image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を開かずにクリップボードを標準テキストでペーストし、画像の場合は認識済みの文字を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 열지 않고 클립보드를 일반 텍스트로 붙여넣으며, 이미지인 경우 인식된 텍스트를 사용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cola a área de transferência como texto simples sem abrir o histórico e usa o texto reconhecido quando ela contém uma imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляет содержимое буфера обычным текстом без открытия истории, используя распознанный текст, если в буфере изображение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不打开历史记录，直接粘贴纯文本；当前剪贴板为图片时使用已识别的文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不開啟記錄，直接貼上純文字；目前剪貼簿為圖片時使用已辨識的文字。"
          }
        }
      }
    },
