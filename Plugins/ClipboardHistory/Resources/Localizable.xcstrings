    "settings.queue.shortcuts.description": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "عيّن «لصق التالي» أولًا؛ عناصر التحكم الأخرى اختيارية." } },
        "de": { "stringUnit": { "state": "translated", "value": "Zuerst „Nächstes einsetzen“ zuweisen; weitere Steuerelemente sind optional." } },
        "en": { "stringUnit": { "state": "translated", "value": "Assign Paste Next first; the other queue controls are optional." } },
        "es": { "stringUnit": { "state": "translated", "value": "Asigna primero Pegar siguiente; los demás controles son opcionales." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Attribuez d’abord Coller le suivant ; les autres commandes sont facultatives." } },
        "ja": { "stringUnit": { "state": "translated", "value": "まず「次をペースト」を設定します。その他は任意です。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "먼저 다음 붙여넣기를 지정하세요. 다른 제어는 선택 사항입니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Atribua Colar próximo primeiro; os demais controles são opcionais." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сначала назначьте «Вставить следующее»; остальные команды необязательны." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先设置“粘贴下一个”；其他队列控制项为可选。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請先設定「貼上下一個」；其他佇列控制項為選用。" } }
      }
    },
