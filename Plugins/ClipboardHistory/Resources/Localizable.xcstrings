    "settings.snippets.clear": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Delete Snippets" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除片段" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "刪除片段" } },
        "ja": { "stringUnit": { "state": "translated", "value": "スニペットを削除" } },
        "ko": { "stringUnit": { "state": "translated", "value": "스니펫 삭제" } },
        "de": { "stringUnit": { "state": "translated", "value": "Textbausteine löschen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprimer les extraits" } },
        "es": { "stringUnit": { "state": "translated", "value": "Eliminar fragmentos" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Apagar trechos" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить фрагменты" } },
