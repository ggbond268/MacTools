    "panel.shortcuts.cycleScope": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تبديل مجموعة التصفية" } },
        "de": { "stringUnit": { "state": "translated", "value": "Filtergruppe wechseln" } },
        "en": { "stringUnit": { "state": "translated", "value": "Cycle Filter Group" } },
        "es": { "stringUnit": { "state": "translated", "value": "Cambiar grupo de filtros" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Changer de groupe de filtres" } },
        "ja": { "stringUnit": { "state": "translated", "value": "フィルタグループを切り替え" } },
        "ko": { "stringUnit": { "state": "translated", "value": "필터 그룹 전환" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Alternar grupo de filtros" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сменить группу фильтров" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "切换筛选组" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "切換篩選群組" } }
      }
    },
    "panel.shortcuts.cycleScope.description": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "التبديل بين مجموعات التصفية المتاحة؛ أضف Shift للرجوع. استخدم Control-1 إلى Control-9 لاختيار خيار في المجموعة النشطة." } },
        "de": { "stringUnit": { "state": "translated", "value": "Zwischen verfügbaren Filtergruppen wechseln; mit Umschalt rückwärts. Control-1 bis Control-9 wählt eine Option in der aktiven Gruppe." } },
        "en": { "stringUnit": { "state": "translated", "value": "Switch between available filter groups; add Shift to go backward. Control-1 through Control-9 chooses an option in the active group." } },
        "es": { "stringUnit": { "state": "translated", "value": "Cambia entre los grupos de filtros disponibles; añade Mayúsculas para retroceder. Control-1 a Control-9 elige una opción del grupo activo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Parcourir les groupes de filtres disponibles ; ajouter Maj pour revenir en arrière. Contrôle-1 à Contrôle-9 sélectionne une option du groupe actif." } },
        "ja": { "stringUnit": { "state": "translated", "value": "使用可能なフィルタグループを切り替えます。Shift を加えると逆方向に切り替わります。Control-1〜Control-9 で現在のグループの項目を選択します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사용 가능한 필터 그룹을 전환합니다. Shift를 추가하면 반대 방향으로 전환합니다. Control-1부터 Control-9까지 눌러 현재 그룹의 옵션을 선택합니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Alterna entre os grupos de filtros disponíveis; adicione Shift para voltar. Control-1 a Control-9 escolhe uma opção do grupo ativo." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Переключение доступных групп фильтров; добавьте Shift для обратного порядка. Control-1–Control-9 выбирает вариант в активной группе." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "切换可用的筛选组；加按 Shift 可反向切换。Control-1 至 Control-9 可选择当前组中的选项。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "切換可用的篩選群組；加按 Shift 可反向切換。Control-1 至 Control-9 可選擇目前群組中的選項。" } }
      }
    },
    "panel.shortcuts.cycleScope.shiftReserved": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "Shift محجوز للتنقل للخلف. سجّل اختصار التنقل للأمام من دون Shift." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Umschalttaste ist für das Rückwärtswechseln reserviert. Zeichne den Vorwärtskurzbefehl ohne Umschalttaste auf." } },
        "en": { "stringUnit": { "state": "translated", "value": "Shift is reserved for cycling backward. Record the forward shortcut without Shift." } },
        "es": { "stringUnit": { "state": "translated", "value": "Mayúsculas está reservado para retroceder. Graba el atajo de avance sin Mayúsculas." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Maj est réservé au parcours inverse. Enregistrez le raccourci suivant sans Maj." } },
        "ja": { "stringUnit": { "state": "translated", "value": "Shift は逆方向の切り替え用に予約されています。順方向のショートカットは Shift なしで記録してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "Shift는 뒤로 순환하는 데 사용됩니다. 앞으로 순환할 단축키는 Shift 없이 기록하십시오." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Shift é reservado para alternar para trás. Grave o atalho para avançar sem Shift." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Shift зарезервирован для обратного переключения. Запишите сочетание для переключения вперёд без Shift." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Shift 保留用于反向切换。请录制不含 Shift 的正向快捷键。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "Shift 保留用於反向切換。請錄製不含 Shift 的正向快速鍵。" } }
      }
    },
    "panel.shortcuts.fixedConflict": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يستخدم اختصار لوحة الحافظة هذا المفتاح من أجل %@." } },
