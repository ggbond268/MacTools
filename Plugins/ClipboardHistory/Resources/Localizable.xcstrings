        "ja": { "stringUnit": { "state": "translated", "value": "空の場合の代替テキスト（任意）" } },
        "ko": { "stringUnit": { "state": "translated", "value": "비어 있을 때 대체 텍스트(선택 사항)" } },
        "de": { "stringUnit": { "state": "translated", "value": "Ersatz bei leerem Inhalt (optional)" } },
