          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板历史超过安全存储上限。请清除现有历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
