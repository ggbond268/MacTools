    "shortcut.pasteSequentially.description": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "الصق العنصر التالي أو ابدأ بلقطة من السجل الحديث." } },
        "de": { "stringUnit": { "state": "translated", "value": "Nächsten Eintrag einsetzen oder mit einem Schnappschuss des Verlaufs beginnen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Paste the next queued item, or start with a snapshot of recent history." } },
        "es": { "stringUnit": { "state": "translated", "value": "Pega el siguiente elemento o inicia una copia del historial reciente." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Collez l’élément suivant ou démarrez avec un instantané de l’historique récent." } },
        "ja": { "stringUnit": { "state": "translated", "value": "次の項目をペーストするか、最近の履歴から開始します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "다음 항목을 붙여넣거나 최근 기록 스냅샷으로 시작합니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Cole o próximo item ou inicie com o histórico recente." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Вставить следующий элемент или начать со снимка недавней истории." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "粘贴下一个队列项目，或从最近历史快照开始。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "貼上下個佇列項目，或從最近記錄快照開始。" } }
      }
    },
    "shortcut.pasteSequentially.groupDescription": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "افتح السجل أو الصق نصاً عادياً أو الصق العناصر واحداً تلو الآخر." } },
        "de": { "stringUnit": { "state": "translated", "value": "Verlauf öffnen, reinen Text einsetzen oder Einträge nacheinander einsetzen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open history, paste plain text, or paste recent entries one at a time." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre el historial, pega texto sin formato o elementos uno a uno." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvrez l’historique, collez du texte brut ou les éléments un par un." } },
        "ja": { "stringUnit": { "state": "translated", "value": "履歴を開く、標準テキストでペースト、または項目を順番にペーストします。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "기록 열기, 일반 텍스트 붙여넣기 또는 항목을 하나씩 붙여넣습니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Abra o histórico, cole texto simples ou itens um a um." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Открыть историю, вставить простой текст или элементы по одному." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开历史、粘贴纯文本，或逐项粘贴最近记录。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "開啟記錄、貼上純文字，或逐項貼上最近項目。" } }
