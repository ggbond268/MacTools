    "setup.collection.errorDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب حل مشكلة التخزين المشفّر أدناه قبل بدء الجمع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behebe unten das Problem mit dem verschlüsselten Speicher, bevor die Erfassung beginnen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the encrypted-storage issue below before collection can start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve el problema de almacenamiento cifrado de abajo antes de iniciar la recopilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez le problème de stockage chiffré ci-dessous avant de démarrer la collecte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収集を開始する前に、下の暗号化ストレージの問題を解決してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수집을 시작하려면 아래의 암호화 저장 공간 문제를 먼저 해결하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva abaixo o problema do armazenamento criptografado antes de iniciar a coleta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед началом сбора устраните указанную ниже проблему с зашифрованным хранилищем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先解决下方的加密存储问题，才能开始收集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須先解決下方的加密儲存問題，才能開始收集。"
          }
        }
      }
    },
    "setup.collection.loadingDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إعداد التخزين المشفّر. يمكنك البدء عند اكتماله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselter Speicher wird vorbereitet. Danach kann es losgehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted storage is being prepared. You can begin when it’s ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está preparando el almacenamiento cifrado. Podrás empezar cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage chiffré est en cours de préparation. Vous pourrez commencer ensuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化ストレージを準備中です。完了すると使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화 저장 공간을 준비 중입니다. 완료되면 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento criptografado está sendo preparado. Você poderá começar quando estiver pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованное хранилище подготавливается. После этого можно начать работу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备加密存储。准备完成后即可开始使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備加密儲存空間。完成後即可開始使用。"
          }
        }
      }
    },
    "setup.collection.pausedDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجمع متوقف حاليًا؛ شغّل «جمع سجل الحافظة» أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassung ist pausiert. Aktiviere unten „Zwischenablageverlauf erfassen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collection is paused. Turn on “Collect Clipboard History” below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopilación está en pausa. Activa «Recopilar historial del portapapeles» abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La collecte est en pause. Activez « Enregistrer l’historique du presse-papiers » ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収集は一時停止中です。下の「クリップボード履歴を収集」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수집이 일시 정지되었습니다. 아래에서 ‘클립보드 기록 수집’을 켜세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A coleta está pausada. Ative “Coletar histórico da área de transferência” abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбор приостановлен. Включите ниже «Сохранять историю буфера обмена»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已暂停；可在下方开启“收集剪贴板历史”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前已暫停；可在下方開啟「收集剪貼簿記錄」。"
          }
        }
      }
    },
    "setup.collection.readyDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز. السجل مشفّر محليًا، وتحتفظ سلسلة المفاتيح بالمفتاح فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit. Der Verlauf ist lokal verschlüsselt; nur der Schlüssel liegt im Schlüsselbund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready. History is encrypted locally; Keychain stores only the key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. El historial se cifra localmente; el Llavero solo guarda la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt. L’historique est chiffré localement ; le trousseau ne contient que la clé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了。履歴はローカルで暗号化され、キーチェーンにはキーのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비되었습니다. 기록은 로컬에서 암호화되며 키체인에는 키만 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto. O histórico é criptografado localmente; as Chaves guardam apenas a chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. История зашифрована локально; в Связке ключей хранится только ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已就绪。历史在本机加密，钥匙串仅保存密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已就緒。記錄在本機加密，鑰匙圈只儲存金鑰。"
          }
        }
      }
    },
