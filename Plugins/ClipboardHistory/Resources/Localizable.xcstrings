    "settings.collection.activeDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجمع قيد التشغيل. يُحفظ السجل في ملف محلي مشفّر، وتحتفظ سلسلة المفاتيح بمفتاح التشفير فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassung ist aktiviert. Der Verlauf liegt in einer lokal verschlüsselten Datei; nur der Schlüssel wird im Schlüsselbund gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collection is on. History is stored in an encrypted local file; Keychain stores only the encryption key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopilación está activada. El historial se guarda en un archivo local cifrado; el Llavero solo contiene la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La collecte est activée. L’historique est conservé dans un fichier local chiffré ; seule la clé est dans le trousseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収集はオンです。履歴は暗号化されたローカルファイルに保存され、キーチェーンには暗号化キーのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수집이 켜져 있습니다. 기록은 암호화된 로컬 파일에 저장되고 키체인에는 암호화 키만 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A coleta está ativada. O histórico fica em um arquivo local criptografado; as Chaves guardam apenas a chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбор включён. История хранится в локальном зашифрованном файле; в Связке ключей находится только ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收集已开启。历史保存在本机加密文件中，钥匙串只保存加密密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收集已開啟。記錄儲存在本機加密檔案中，鑰匙圈只儲存加密金鑰。"
          }
        }
      }
    },
    "settings.collection.pausedDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجمع متوقف مؤقتًا؛ يبقى السجل المشفّر الحالي محفوظًا محليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassung ist pausiert; der bestehende verschlüsselte Verlauf bleibt lokal erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collection is paused; existing encrypted history remains stored locally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopilación está en pausa; el historial cifrado existente permanece guardado localmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La collecte est en pause ; l’historique chiffré existant reste stocké localement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収集は一時停止中です。既存の暗号化された履歴はローカルに保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수집이 일시 정지되었습니다. 기존 암호화 기록은 로컬에 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A coleta está pausada; o histórico criptografado existente permanece armazenado localmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбор приостановлен; существующая зашифрованная история остаётся на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收集已暂停；现有加密历史仍保留在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收集已暫停；現有加密記錄仍保留在本機。"
          }
        }
      }
    },
