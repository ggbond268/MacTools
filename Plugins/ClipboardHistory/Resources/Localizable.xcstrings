    "error.historyTooLarge": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز سجل الحافظة حد التخزين الآمن. امسح السجل الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zwischenablageverlauf überschreitet das sichere Speicherlimit. Lösche den vorhandenen Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard history exceeds the safe storage limit. Clear the existing history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial del portapapeles supera el límite de almacenamiento seguro. Borra el historial actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
