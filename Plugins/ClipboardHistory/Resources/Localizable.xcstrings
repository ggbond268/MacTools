    "action.clearAll.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف نهائيًا كل عناصر الحافظة والمقتطفات المثبتة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einträge und angehefteten Ausschnitte dauerhaft löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete all clipboard items and pinned snippets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todos los elementos y fragmentos fijados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement tous les éléments et extraits épinglés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての項目と固定スニペットを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 클립보드 항목과 고정된 스니펫을 영구 삭제합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui permanentemente todos os itens e trechos fixados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удалить все записи и закреплённые фрагменты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除所有剪贴板记录和固定片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除所有剪貼簿記錄和固定片段。"
          }
        }
      }
    },
