    "panel.shortcuts.reverseCycleConflict": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "هذا المفتاح محجوز للتنقل بين عوامل التصفية للخلف بواسطة %@." } },
        "de": { "stringUnit": { "state": "translated", "value": "Diese Taste ist durch %@ für das Rückwärtswechseln der Filter reserviert." } },
        "en": { "stringUnit": { "state": "translated", "value": "This key is reserved for cycling filters backward by %@." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esta tecla está reservada por %@ para recorrer los filtros hacia atrás." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cette touche est réservée par %@ pour parcourir les filtres en sens inverse." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このキーは「%@」によるフィルタの逆方向切り替え用に予約されています。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 키는 %@의 필터 뒤로 전환에 사용됩니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Esta tecla é reservada por %@ para alternar os filtros para trás." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Эта клавиша зарезервирована действием «%@» для обратного переключения фильтров." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此按键由“%@”保留用于反向切换筛选条件。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此按鍵由「%@」保留用於反向切換篩選條件。" } }
      }
    },
    "panel.shortcuts.actions": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "إظهار الإجراءات أو إخفاؤها" } },
        "de": { "stringUnit": { "state": "translated", "value": "Aktionen ein-/ausblenden" } },
        "en": { "stringUnit": { "state": "translated", "value": "Toggle Actions" } },
        "es": { "stringUnit": { "state": "translated", "value": "Mostrar u ocultar acciones" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Afficher ou masquer les actions" } },
        "ja": { "stringUnit": { "state": "translated", "value": "アクションの表示を切り替える" } },
        "ko": { "stringUnit": { "state": "translated", "value": "동작 표시 전환" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Mostrar ou ocultar ações" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Показать или скрыть действия" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "显示或隐藏操作" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "顯示或隱藏操作" } }
      }
    },
    "panel.shortcuts.actions.description": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "افتح الإجراءات أو أغلقها للعودة إلى البحث في السجل." } },
        "de": { "stringUnit": { "state": "translated", "value": "Aktionen öffnen oder schließen und zur Verlaufssuche zurückkehren." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open Actions or close it and return to the history search." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Acciones o ciérralo para volver a buscar en el historial." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvrez les actions ou fermez-les pour revenir à la recherche dans l’historique." } },
        "ja": { "stringUnit": { "state": "translated", "value": "アクションを開くか、閉じて履歴検索に戻ります。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "동작을 열거나 닫고 기록 검색으로 돌아갑니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Abra Ações ou feche para voltar à pesquisa no histórico." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте действия или закройте их, чтобы вернуться к поиску в истории." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开操作，或关闭并返回历史搜索。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "開啟操作，或關閉並返回歷史搜尋。" } }
      }
    },
    "panel.shortcuts.toggleSelection.description": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "في وضع التحديد المتعدد، حدد العنصر المميز أو ألغِ تحديده، حتى أثناء التركيز على حقل البحث." } },
        "de": { "stringUnit": { "state": "translated", "value": "Im Mehrfachauswahlmodus das hervorgehobene Objekt auswählen oder abwählen, auch wenn das Suchfeld fokussiert ist." } },
        "en": { "stringUnit": { "state": "translated", "value": "In multi-select mode, select or unselect the highlighted item, even while the search field is focused." } },
        "es": { "stringUnit": { "state": "translated", "value": "En selección múltiple, marca o desmarca el elemento resaltado incluso con el campo de búsqueda enfocado." } },
        "fr": { "stringUnit": { "state": "translated", "value": "En sélection multiple, cochez ou décochez l’élément en surbrillance, même lorsque le champ de recherche est actif." } },
        "ja": { "stringUnit": { "state": "translated", "value": "複数選択モードで、検索欄にフォーカスがある場合も強調表示された項目の選択を切り替えます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "다중 선택 모드에서 검색 필드에 포커스가 있어도 강조 표시된 항목을 선택하거나 선택 해제합니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "No modo de seleção múltipla, marque ou desmarque o item destacado mesmo com o campo de pesquisa em foco." } },
