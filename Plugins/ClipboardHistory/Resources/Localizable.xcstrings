    "settings.retention.expiration.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعطّل «أبدًا» انتهاء السجل حسب العمر؛ وقد تزيل حدود السعة أقدم عناصر السجل. ولا تتأثر العناصر المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nie“ deaktiviert den zeitbasierten Ablauf. Kapazitätsgrenzen können den ältesten Verlauf entfernen; gespeicherte Elemente bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never disables age-based expiration; capacity limits may still remove the oldest History items. Saved items are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca desactiva la caducidad por antigüedad; los límites de capacidad aún pueden eliminar el historial más antiguo. Los elementos guardados no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais désactive l’expiration selon l’âge ; les limites de capacité peuvent encore supprimer l’historique le plus ancien. Les éléments enregistrés ne sont pas affectés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「しない」は期間による期限切れを無効にします。容量上限により古い履歴が削除される場合があります。保存済み項目には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안 함은 기간에 따른 만료를 끕니다. 용량 한도에 따라 오래된 기록은 삭제될 수 있으며 저장된 항목에는 영향을 주지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca desativa a expiração por idade; os limites de capacidade ainda podem remover o histórico mais antigo. Os itens salvos não são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Никогда» отключает удаление по возрасту; лимиты ёмкости всё ещё могут удалить самую старую историю. Сохранённые элементы не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“永不”会关闭按时间过期；容量上限仍可能移除最早的历史。已存项目不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「永不」會關閉按時間到期；容量上限仍可能移除最早的記錄。已儲存項目不受影響。"
          }
        }
      }
    },
