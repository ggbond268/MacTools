    "settings.shortcuts.collection.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: تحكّم في الجمع أو امسح السجل؛ تظل عمليات المسح بحاجة إلى تأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Steuere die Erfassung oder lösche den Verlauf; Löschvorgänge müssen weiterhin bestätigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: control collection or clear history; clearing still requires confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: controla la recopilación o borra el historial; el borrado aún requiere confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : contrôlez la collecte ou effacez l’historique ; l’effacement demande toujours confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：収集を制御したり履歴を消去したりできます。消去には引き続き確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: 수집을 제어하거나 기록을 지울 수 있으며, 지우기에는 계속 확인이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: controle a coleta ou limpe o histórico; a limpeza ainda exige confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно: управляйте сбором или очищайте историю; очистка по-прежнему требует подтверждения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：控制收集状态或清除历史；清除操作仍需确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選：控制收集狀態或清除記錄；清除操作仍需確認。"
          }
        }
      }
    }
  },
  "version": "1.0"
