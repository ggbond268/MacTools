        "ar": { "stringUnit": { "state": "translated", "value": "لا يوفّر هذا الحقل محرر نصوص غير آمن مدعومًا. الصق المقتطف من الحافظة بدلاً من ذلك." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dieses Feld bietet keinen unterstützten, ungeschützten Texteditor. Füge den Textbaustein aus der Zwischenablage ein." } },
        "en": { "stringUnit": { "state": "translated", "value": "This field does not expose a supported, non-secure text editor. Paste the snippet from Clipboard instead." } },
        "es": { "stringUnit": { "state": "translated", "value": "Este campo no ofrece un editor de texto no protegido compatible. Pega el fragmento desde Portapapeles." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ce champ n’expose pas d’éditeur de texte non sécurisé compatible. Collez l’extrait depuis le presse-papiers." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このフィールドは対応する非保護テキストエディタを公開していません。クリップボードからスニペットを貼り付けてください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 필드는 지원되는 비보안 텍스트 편집기를 제공하지 않습니다. 클립보드에서 스니펫을 붙여넣으세요." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Este campo não disponibiliza um editor de texto não protegido compatível. Cole o trecho pela Área de Transferência." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Это поле не предоставляет поддерживаемый незащищённый текстовый редактор. Вставьте шаблон через буфер обмена." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此输入框未提供受支持的非安全文本编辑接口，请从剪贴板粘贴片段。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此輸入框未提供支援的非安全文字編輯介面，請從剪貼簿貼上片段。" } }
      }
