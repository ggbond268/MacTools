          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴が安全な保存上限を超えています。既存の履歴を消去してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록이 안전한 저장 한도를 초과했습니다. 기존 기록을 지우십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico da área de transferência excede o limite de armazenamento seguro. Limpe o histórico existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
