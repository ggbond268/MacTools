    "action.clearAll.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف نهائيًا كل عناصر السجل من دون إزالة العناصر المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Verlaufselemente dauerhaft löschen, ohne gespeicherte Elemente zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete all History items without removing Saved items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todos los elementos del historial sin borrar los guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement tous les éléments de l’historique sans retirer les éléments enregistrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み項目を残したまま、すべての履歴項目を完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 항목은 유지하고 모든 기록 항목을 영구 삭제합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga permanentemente todos os itens do histórico sem remover os itens salvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удалить все элементы истории, не удаляя сохранённые элементы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除所有历史项目，但不移除已存项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除所有記錄項目，但不移除已儲存項目。"
          }
        }
      }
    },
