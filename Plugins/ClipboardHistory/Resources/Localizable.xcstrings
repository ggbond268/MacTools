    "clear.all.actionMessage": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف جميع عناصر السجل نهائيًا. لن تتأثر العناصر المحفوظة. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Verlaufselemente werden dauerhaft gelöscht. Gespeicherte Elemente bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All History items will be permanently deleted. Saved items are not affected. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los elementos del historial se eliminarán permanentemente. Los guardados no se verán afectados. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les éléments de l’historique seront définitivement supprimés. Les éléments enregistrés ne seront pas affectés. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての履歴項目が完全に削除されます。保存済み項目には影響しません。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기록 항목이 영구적으로 삭제됩니다. 저장된 항목에는 영향을 주지 않습니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os itens do histórico serão apagados permanentemente. Os itens salvos não serão afetados. Isto não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все элементы истории будут удалены безвозвратно. Сохранённые элементы не изменятся. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有历史项目都将永久删除。已存项目不受影响。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有記錄項目都將永久刪除。已儲存項目不受影響。此操作無法還原。"
          }
        }
      }
    },
