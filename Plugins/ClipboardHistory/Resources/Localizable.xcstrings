    "clear.unpinned.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستبقى المقتطفات المثبتة. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Ausschnitte bleiben erhalten. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
