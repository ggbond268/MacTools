        "fr": { "stringUnit": { "state": "translated", "value": "Prêt" } },
        "ja": { "stringUnit": { "state": "translated", "value": "準備完了" } },
        "ko": { "stringUnit": { "state": "translated", "value": "준비됨" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Pronto" } },
