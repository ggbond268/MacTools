    "setup.collection.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد حالة الجمع"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassungsstatus prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Collection Status"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar el estado de recopilación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmer l’état de la collecte"
          }
        },
        "ja": {
          "stringUnit": {
