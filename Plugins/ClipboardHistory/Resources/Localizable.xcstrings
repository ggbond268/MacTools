        "ru": { "stringUnit": { "state": "translated", "value": "Очистить сохранённые записи" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "清除已存剪贴" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "清除已儲存剪貼" } }
      }
    },
    "settings.saved.clear.confirm": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "مسح المكتبة المحفوظة" } },
        "de": { "stringUnit": { "state": "translated", "value": "Bibliothek löschen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Clear Saved Library" } },
        "es": { "stringUnit": { "state": "translated", "value": "Borrar biblioteca guardada" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Effacer la bibliothèque" } },
        "ja": { "stringUnit": { "state": "translated", "value": "保存済みライブラリを消去" } },
        "ko": { "stringUnit": { "state": "translated", "value": "저장된 보관함 지우기" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Limpar biblioteca salva" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Очистить библиотеку" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "清除已存资料库" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "清除已儲存資料庫" } }
      }
    },
    "settings.saved.clear.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Removes Saved status from clips in History and permanently deletes Saved-only clips. History and snippets are kept. This cannot be undone." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "取消历史中剪辑的已存状态，并永久删除仅保存在已存中的剪辑。历史和片段会保留。此操作无法撤销。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "取消記錄中剪輯的已儲存狀態，並永久刪除僅保存在已儲存中的剪輯。記錄和片段會保留。此操作無法復原。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "履歴内のクリップの保存状態を解除し、保存済みにのみ存在するクリップを完全に削除します。履歴とスニペットは保持されます。この操作は取り消せません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "기록에 있는 클립의 저장 상태를 해제하고 저장됨에만 있는 클립을 영구 삭제합니다. 기록과 스니펫은 유지됩니다. 이 작업은 되돌릴 수 없습니다." } },
        "de": { "stringUnit": { "state": "translated", "value": "Entfernt den Gespeichert-Status von Clips im Verlauf und löscht ausschließlich gespeicherte Clips dauerhaft. Verlauf und Textbausteine bleiben erhalten. Dies kann nicht rückgängig gemacht werden." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Retire le statut enregistré des clips de l’historique et supprime définitivement ceux qui n’existent que dans les éléments enregistrés. L’historique et les extraits sont conservés. Cette action est irréversible." } },
        "es": { "stringUnit": { "state": "translated", "value": "Quita el estado guardado de los clips del historial y elimina permanentemente los que solo están guardados. El historial y los fragmentos se conservan. Esta acción no se puede deshacer." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Remove o estado salvo dos clipes no histórico e apaga permanentemente os clipes que estão apenas salvos. O histórico e os trechos são mantidos. Esta ação não pode ser desfeita." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Снимает статус сохранения с клипов в истории и безвозвратно удаляет клипы, которых нет в истории. История и фрагменты остаются. Это действие нельзя отменить." } },
        "ar": { "stringUnit": { "state": "translated", "value": "يزيل حالة الحفظ من القصاصات الموجودة في السجل ويحذف نهائيًا القصاصات المحفوظة غير الموجودة في السجل. يبقى السجل والمقتطفات. لا يمكن التراجع عن هذا الإجراء." } }
      }
    },
    "settings.saved.clear.title": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "هل تريد مسح المكتبة المحفوظة؟" } },
        "de": { "stringUnit": { "state": "translated", "value": "Bibliothek löschen?" } },
        "en": { "stringUnit": { "state": "translated", "value": "Clear Saved Library?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Borrar la biblioteca guardada?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Effacer la bibliothèque ?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "保存済みライブラリを消去しますか？" } },
        "ko": { "stringUnit": { "state": "translated", "value": "저장된 보관함을 지우시겠습니까?" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Limpar biblioteca salva?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Очистить библиотеку?" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "清除已存资料库？" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "清除已儲存資料庫？" } }
      }
    },
    "settings.saved.expansion.description": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "استبدال كلمة المقتطف الواضحة فورًا أثناء الكتابة. يتم تجاهل حقول النص الآمنة." } },
        "de": { "stringUnit": { "state": "translated", "value": "Eindeutige Snippet-Kürzel direkt beim Tippen ersetzen. Sichere Textfelder werden ignoriert." } },
        "en": { "stringUnit": { "state": "translated", "value": "Immediately replace an unambiguous snippet keyword as you type. Secure text fields are ignored." } },
        "es": { "stringUnit": { "state": "translated", "value": "Reemplaza al escribir una palabra clave de fragmento sin ambigüedad. Se omiten los campos de texto seguros." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Remplace immédiatement les mots-clés d’extrait sans ambiguïté pendant la saisie. Les champs sécurisés sont ignorés." } },
        "ja": { "stringUnit": { "state": "translated", "value": "曖昧さのないスニペットのキーワードを入力すると即座に置換します。セキュア入力欄は無視されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "명확한 스니펫 키워드를 입력하면 즉시 바꿉니다. 보안 텍스트 필드는 무시합니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Substitui imediatamente uma palavra-chave de trecho sem ambiguidade ao escrever. Os campos seguros são ignorados." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сразу заменяет однозначные ключевые слова фрагментов при вводе. Защищённые поля игнорируются." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "输入无歧义的完整片段关键词时立即替换。安全文本字段会被忽略。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "輸入無歧義的完整片段關鍵字時立即替換。安全文字欄位會被忽略。" } }
      }
    },
