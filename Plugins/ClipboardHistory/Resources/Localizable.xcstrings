    "shortcut.group.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسخ «نسخ خاص الآن» التحديد الحالي بخطوة واحدة؛ وينتظر «تجاهل النسخة التالية» نسخة لاحقة عبر القائمة السياقية أو Command-C ويلغى بعد 15 ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jetzt privat kopieren“ kopiert die aktuelle Auswahl in einem Schritt. „Nächste Kopie ignorieren“ wartet auf ein späteres Kopieren per Kontextmenü oder Command-C und wird nach 15 Sekunden abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Private Copy Now” copies the current selection in one step. “Ignore Next Copy” waits for a later context-menu or Command-C copy and cancels after 15 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Copia privada ahora» copia la selección en un paso. «Ignorar la próxima copia» espera una copia posterior desde el menú contextual o con Command-C y se cancela tras 15 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Copier en privé maintenant » copie la sélection en une étape. « Ignorer la prochaine copie » attend une copie ultérieure via le menu contextuel ou Command-C et s’annule après 15 secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今すぐプライベートコピー」は現在の選択を1ステップでコピーします。「次のコピーを無視」は後のコンテキストメニューまたはCommand-Cを待ち、15秒後に解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘지금 비공개 복사’는 현재 선택을 한 번에 복사합니다. ‘다음 복사 무시’는 이후 컨텍스트 메뉴 또는 Command-C 복사를 기다리며 15초 후 취소됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Copiar em privado agora” copia a seleção em uma etapa. “Ignorar próxima cópia” aguarda uma cópia posterior pelo menu de contexto ou Command-C e é cancelado após 15 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скопировать приватно сейчас» копирует выделенное за один шаг. «Игнорировать следующее копирование» ожидает последующее копирование через контекстное меню или Command-C и отменяется через 15 секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“立即私密复制”一步复制当前选择；“忽略下一次复制”会等待之后的右键菜单或 Command-C，15 秒后自动取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「立即私密複製」一步複製目前選取內容；「忽略下一次複製」會等待之後的右鍵選單或 Command-C，15 秒後自動取消。"
          }
        }
      }
    },
    "shortcut.group.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختصارات نسخ المحتوى الحساس"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
