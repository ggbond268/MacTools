    "settings.expansion.selection": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "لا يكشف هذا المحرر عن تحديد النص. الصق المقتطف من الحافظة." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dieser Editor stellt die Textauswahl nicht bereit. Füge den Textbaustein aus der Zwischenablage ein." } },
        "en": { "stringUnit": { "state": "translated", "value": "This editor does not expose its text selection. Paste the snippet from Clipboard instead." } },
        "es": { "stringUnit": { "state": "translated", "value": "Este editor no expone la selección de texto. Pega el fragmento desde Portapapeles." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cet éditeur n’expose pas la sélection de texte. Collez l’extrait depuis le presse-papiers." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このエディタはテキスト選択を公開していません。クリップボードからスニペットを貼り付けてください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 편집기는 텍스트 선택 영역을 제공하지 않습니다. 클립보드에서 스니펫을 붙여넣으세요." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Este editor não disponibiliza a seleção de texto. Cole o trecho pela Área de Transferência." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Редактор не предоставляет выделение текста. Вставьте шаблон через буфер обмена." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此编辑器未提供文本选区，请从剪贴板粘贴片段。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此編輯器未提供文字選取範圍，請從剪貼簿貼上片段。" } }
      }
    },
    "settings.expansion.contextChanged": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تغيّر النص أو المؤشر قبل التوسيع؛ لم يُستبدل شيء." } },
        "de": { "stringUnit": { "state": "translated", "value": "Text oder Cursor wurden vor der Erweiterung geändert; nichts wurde ersetzt." } },
        "en": { "stringUnit": { "state": "translated", "value": "The text or cursor changed before expansion; nothing was replaced." } },
        "es": { "stringUnit": { "state": "translated", "value": "El texto o el cursor cambió antes de expandir; no se reemplazó nada." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le texte ou le curseur a changé avant l’expansion ; rien n’a été remplacé." } },
        "ja": { "stringUnit": { "state": "translated", "value": "展開前にテキストまたはカーソルが変わったため、置換しませんでした。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "확장 전에 텍스트나 커서가 변경되어 바꾸지 않았습니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "O texto ou cursor mudou antes da expansão; nada foi substituído." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Текст или курсор изменился до подстановки; ничего не заменено." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "展开前文本或光标已变化，未进行替换。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "展開前文字或游標已變更，未進行取代。" } }
      }
    },
