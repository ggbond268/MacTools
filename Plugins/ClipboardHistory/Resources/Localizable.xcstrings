    "saved.error.invalidDateFormat": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يحتوي المقتطف على تنسيق تاريخ أو وقت غير صالح." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Textbaustein enthält ein ungültiges Datums- oder Zeitformat." } },
        "en": { "stringUnit": { "state": "translated", "value": "The snippet contains an invalid date or time format." } },
        "es": { "stringUnit": { "state": "translated", "value": "El fragmento contiene un formato de fecha u hora no válido." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’extrait contient un format de date ou d’heure non valide." } },
        "ja": { "stringUnit": { "state": "translated", "value": "スニペットに無効な日付または時刻の形式があります。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "스니펫에 잘못된 날짜 또는 시간 형식이 있습니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "O trecho contém um formato de data ou hora inválido." } },
