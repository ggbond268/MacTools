    "shortcut.group.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسخ «نسخ خاص الآن» التحديد الحالي بخطوة واحدة؛ وينتظر «تجاهل النسخة التالية» نسخة لاحقة عبر القائمة السياقية أو Command-C ويلغى بعد 15 ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jetzt privat kopieren“ kopiert die aktuelle Auswahl in einem Schritt. „Nächste Kopie ignorieren“ wartet auf ein späteres Kopieren per Kontextmenü oder Command-C und wird nach 15 Sekunden abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Private Copy Now” copies the current selection in one step. “Ignore Next Copy” waits for a later context-menu or Command-C copy and cancels after 15 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Copia privada ahora» copia la selección en un paso. «Ignorar la próxima copia» espera una copia posterior desde el menú contextual o con Command-C y se cancela tras 15 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Copier en privé maintenant » copie la sélection en une étape. « Ignorer la prochaine copie » attend une copie ultérieure via le menu contextuel ou Command-C et s’annule après 15 secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今すぐプライベートコピー」は現在の選択を1ステップでコピーします。「次のコピーを無視」は後のコンテキストメニューまたはCommand-Cを待ち、15秒後に解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘지금 비공개 복사’는 현재 선택을 한 번에 복사합니다. ‘다음 복사 무시’는 이후 컨텍스트 메뉴 또는 Command-C 복사를 기다리며 15초 후 취소됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Copiar em privado agora” copia a seleção em uma etapa. “Ignorar próxima cópia” aguarda uma cópia posterior pelo menu de contexto ou Command-C e é cancelado após 15 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скопировать приватно сейчас» копирует выделенное за один шаг. «Игнорировать следующее копирование» ожидает последующее копирование через контекстное меню или Command-C и отменяется через 15 секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“立即私密复制”一步复制当前选择；“忽略下一次复制”会等待之后的右键菜单或 Command-C，15 秒后自动取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「立即私密複製」一步複製目前選取內容；「忽略下一次複製」會等待之後的右鍵選單或 Command-C，15 秒後自動取消。"
          }
        }
      }
    },
    "shortcut.group.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختصارات نسخ المحتوى الحساس"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle für sensible Kopien"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive Copy Shortcuts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos de copia sensible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis de copie sensible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密コピーのショートカット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 콘텐츠 복사 단축키"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atalhos para cópias confidenciais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания для конфиденциального копирования"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感内容复制快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感內容複製快速鍵"
          }
        }
      }
    },
    "shortcut.ignoreNext.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتم قراءة التغيير التالي في الحافظة أو حفظه، وسيُلغى تلقائيًا بعد 15 ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Änderung der Zwischenablage wird weder gelesen noch gespeichert und nach 15 Sekunden automatisch abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next clipboard change won’t be read or saved and will cancel automatically after 15 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El próximo cambio del portapapeles no se leerá ni guardará y se cancelará automáticamente tras 15 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine modification du presse-papiers ne sera ni lue ni enregistrée et s’annulera automatiquement après 15 secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のクリップボード変更は読み取りも保存もされず、15秒後に自動的に解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 클립보드 변경은 읽거나 저장하지 않으며 15초 후 자동으로 취소됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima alteração da área de transferência não será lida nem salva e será cancelada automaticamente após 15 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее изменение буфера обмена не будет прочитано или сохранено и отменится через 15 секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来一次剪贴板变化不会被读取或保存，15 秒后自动取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來一次剪貼簿變更不會被讀取或儲存，15 秒後自動取消。"
          }
        }
      }
    },
