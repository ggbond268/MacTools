{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "settings.collection.toggleTitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع سجل الحافظة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablageverlauf erfassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect Clipboard History"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recopilar historial del portapapeles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer l’historique du presse-papiers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴を収集"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록 수집"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coletar histórico da área de transferência"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять историю буфера обмена"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收集剪贴板历史"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收集剪貼簿記錄"
          }
        }
      }
    },
    "settings.collection.loadingDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إعداد التخزين المحلي المشفّر…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselter lokaler Speicher wird vorbereitet …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing encrypted local storage…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando el almacenamiento local cifrado…"
          }
