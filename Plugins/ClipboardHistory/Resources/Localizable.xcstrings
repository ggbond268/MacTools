    "permission.accessibility.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم لإرسال Command-C للنسخ الخاص، وكذلك للصق عبر Return وShift-Return و⌘1–9 في التطبيق السابق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Command-C für „Privates Kopieren“ und fügt mit Return, Shift-Return und ⌘1–9 in die vorherige App ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends Command-C for Private Copy and lets Return, Shift-Return, and ⌘1–9 paste into the previously active app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía Command-C para Copia privada y permite pegar con Return, Shift-Return y ⌘1–9 en la app anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie Command-C pour Copie privée et permet de coller avec Return, Shift-Return et ⌘1–9 dans l’app précédente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートコピーでCommand-Cを送信し、Return、Shift-Return、⌘1〜9で直前のアプリにペーストするために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 복사에 Command-C를 보내고 Return, Shift-Return 및 ⌘1–9로 이전 앱에 붙여넣는 데 사용됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia Command-C para Cópia privada e permite colar com Return, Shift-Return e ⌘1–9 no app anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет Command-C для приватного копирования и позволяет вставлять по Return, Shift-Return и ⌘1–9 в предыдущее приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于“私密复制”发送 Command-C，也用于 Return、Shift-Return 和 ⌘1–9 将记录粘贴到之前的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於「私密複製」傳送 Command-C，也用於 Return、Shift-Return 和 ⌘1–9 將記錄貼到之前的 App。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتاج الجمع والبحث والنسخ إلى هذا الإذن؛ يحتاجه النسخ الخاص واللصق عبر Return وShift-Return و⌘1–9."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammeln, Suchen und Kopieren benötigen sie nicht; nur Privates Kopieren und Einfügen mit Return, Shift-Return und ⌘1–9."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collection, search, and copying don’t need it; Private Copy and pasting with Return, Shift-Return, or ⌘1–9 do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recopilar, buscar y copiar no lo necesitan; Copia privada y pegar con Return, Shift-Return o ⌘1–9 sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La collecte, la recherche et la copie n’en ont pas besoin ; Copie privée et le collage avec Return, Shift-Return ou ⌘1–9 l’utilisent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収集、検索、コピーには不要です。プライベートコピーとReturn、Shift-Return、⌘1〜9でのペーストに使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수집, 검색, 복사에는 필요하지 않으며 비공개 복사와 Return, Shift-Return, ⌘1–9 붙여넣기에 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coletar, pesquisar e copiar não precisam; Cópia privada e colar com Return, Shift-Return ou ⌘1–9 precisam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбор, поиск и копирование не требуют его; приватное копирование и вставка по Return, Shift-Return или ⌘1–9 требуют."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通收集、搜索和复制不需要此权限；私密复制以及 Return、Shift-Return 和 ⌘1–9 粘贴需要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般收集、搜尋和複製不需要此權限；私密複製以及 Return、Shift-Return 和 ⌘1–9 貼上需要。"
          }
        }
      }
    },
