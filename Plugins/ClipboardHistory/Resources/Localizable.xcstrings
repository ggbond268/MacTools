    "panel.shortcuts.selectAll.description": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "في وضع التحديد المتعدد، حدّد كل العناصر المعروضة من دون نقل التركيز من البحث." } },
