    "settings.menuBar.preview": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "معاينة مباشرة" } },
        "de": { "stringUnit": { "state": "translated", "value": "Live-Vorschau" } },
        "en": { "stringUnit": { "state": "translated", "value": "Live Preview" } },
