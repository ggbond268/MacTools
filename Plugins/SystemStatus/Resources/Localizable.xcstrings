        "de": { "stringUnit": { "state": "translated", "value": "Layout der Menüleistenmetriken" } },
        "en": { "stringUnit": { "state": "translated", "value": "Menu Bar Metrics Layout" } },
        "es": { "stringUnit": { "state": "translated", "value": "Diseño de métricas de la barra de menús" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Disposition des indicateurs de la barre des menus" } },
        "ja": { "stringUnit": { "state": "translated", "value": "メニューバー指標のレイアウト" } },
        "ko": { "stringUnit": { "state": "translated", "value": "메뉴 막대 측정항목 레이아웃" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Layout das métricas da barra de menus" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Макет показателей строки меню" } },
