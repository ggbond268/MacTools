    "settings.menuBar.setAllMetricsTo": { "extractionState": "manual", "localizations": { "ar": { "stringUnit": { "state": "translated", "value": "تعيين كل المقاييس إلى" } }, "de": { "stringUnit": { "state": "translated", "value": "Alle Metriken festlegen als" } }, "en": { "stringUnit": { "state": "translated", "value": "Set All Metrics To" } }, "es": { "stringUnit": { "state": "translated", "value": "Establecer todas las métricas como" } }, "fr": { "stringUnit": { "state": "translated", "value": "Définir toutes les mesures sur" } }, "ja": { "stringUnit": { "state": "translated", "value": "すべての指標を設定" } }, "ko": { "stringUnit": { "state": "translated", "value": "모든 지표 설정" } }, "pt": { "stringUnit": { "state": "translated", "value": "Definir todas as métricas como" } }, "ru": { "stringUnit": { "state": "translated", "value": "Установить для всех показателей" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "所有指标设为" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "所有指標設為" } } } },
    "settings.menuBar.reset": { "extractionState": "manual", "localizations": { "ar": { "stringUnit": { "state": "translated", "value": "إعادة تعيين" } }, "de": { "stringUnit": { "state": "translated", "value": "Zurücksetzen" } }, "en": { "stringUnit": { "state": "translated", "value": "Reset" } }, "es": { "stringUnit": { "state": "translated", "value": "Restablecer" } }, "fr": { "stringUnit": { "state": "translated", "value": "Réinitialiser" } }, "ja": { "stringUnit": { "state": "translated", "value": "リセット" } }, "ko": { "stringUnit": { "state": "translated", "value": "재설정" } }, "pt": { "stringUnit": { "state": "translated", "value": "Redefinir" } }, "ru": { "stringUnit": { "state": "translated", "value": "Сбросить" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "重置" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "重設" } } } },
    "settings.menuBar.resetStylesAndLayout": { "extractionState": "manual", "localizations": { "ar": { "stringUnit": { "state": "translated", "value": "إعادة تعيين الأنماط والتخطيط" } }, "de": { "stringUnit": { "state": "translated", "value": "Stile und Layout zurücksetzen" } }, "en": { "stringUnit": { "state": "translated", "value": "Reset Styles & Layout" } }, "es": { "stringUnit": { "state": "translated", "value": "Restablecer estilos y diseño" } }, "fr": { "stringUnit": { "state": "translated", "value": "Réinitialiser les styles et la disposition" } }, "ja": { "stringUnit": { "state": "translated", "value": "スタイルとレイアウトをリセット" } }, "ko": { "stringUnit": { "state": "translated", "value": "스타일 및 레이아웃 재설정" } }, "pt": { "stringUnit": { "state": "translated", "value": "Redefinir estilos e layout" } }, "ru": { "stringUnit": { "state": "translated", "value": "Сбросить стили и макет" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "重置样式与布局" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "重設樣式與佈局" } } } },
    "settings.menuBar.resetAll": { "extractionState": "manual", "localizations": { "ar": { "stringUnit": { "state": "translated", "value": "إعادة تعيين جميع إعدادات شريط القائمة…" } }, "de": { "stringUnit": { "state": "translated", "value": "Alle Menüleisteneinstellungen zurücksetzen …" } }, "en": { "stringUnit": { "state": "translated", "value": "Reset All Menu Bar Settings…" } }, "es": { "stringUnit": { "state": "translated", "value": "Restablecer todos los ajustes de la barra de menús…" } }, "fr": { "stringUnit": { "state": "translated", "value": "Réinitialiser tous les réglages de la barre des menus…" } }, "ja": { "stringUnit": { "state": "translated", "value": "メニューバーのすべての設定をリセット…" } }, "ko": { "stringUnit": { "state": "translated", "value": "모든 메뉴 막대 설정 재설정…" } }, "pt": { "stringUnit": { "state": "translated", "value": "Redefinir todos os ajustes da barra de menus…" } }, "ru": { "stringUnit": { "state": "translated", "value": "Сбросить все настройки строки меню…" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "重置所有菜单栏设置…" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "重設所有選單列設定…" } } } },
    "settings.menuBar.resetAll.confirmationTitle": { "extractionState": "manual", "localizations": { "ar": { "stringUnit": { "state": "translated", "value": "إعادة تعيين جميع إعدادات شريط القائمة؟" } }, "de": { "stringUnit": { "state": "translated", "value": "Alle Menüleisteneinstellungen zurücksetzen?" } }, "en": { "stringUnit": { "state": "translated", "value": "Reset All Menu Bar Settings?" } }, "es": { "stringUnit": { "state": "translated", "value": "¿Restablecer todos los ajustes de la barra de menús?" } }, "fr": { "stringUnit": { "state": "translated", "value": "Réinitialiser tous les réglages de la barre des menus ?" } }, "ja": { "stringUnit": { "state": "translated", "value": "メニューバーのすべての設定をリセットしますか？" } }, "ko": { "stringUnit": { "state": "translated", "value": "모든 메뉴 막대 설정을 재설정할까요?" } }, "pt": { "stringUnit": { "state": "translated", "value": "Redefinir todos os ajustes da barra de menus?" } }, "ru": { "stringUnit": { "state": "translated", "value": "Сбросить все настройки строки меню?" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "重置所有菜单栏设置？" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "重設所有選單列設定？" } } } },
    "settings.menuBar.resetAll.confirmationMessage": { "extractionState": "manual", "localizations": { "ar": { "stringUnit": { "state": "translated", "value": "سيؤدي هذا إلى استعادة أنماط مؤشرات شريط القائمة وقيمها وحالة ظهورها وترتيبها." } }, "de": { "stringUnit": { "state": "translated", "value": "Dadurch werden Stile, Werte, Sichtbarkeit und Reihenfolge der Menüleistenmetriken zurückgesetzt." } }, "en": { "stringUnit": { "state": "translated", "value": "This restores the styles, values, visibility, and order of menu bar metrics." } }, "es": { "stringUnit": { "state": "translated", "value": "Esto restaura los estilos, valores, visibilidad y orden de las métricas de la barra de menús." } }, "fr": { "stringUnit": { "state": "translated", "value": "Cette opération rétablit les styles, les valeurs, la visibilité et l’ordre des indicateurs de la barre des menus." } }, "ja": { "stringUnit": { "state": "translated", "value": "メニューバー指標のスタイル、値、表示状態、順序が復元されます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "메뉴 막대 지표의 스타일, 값, 표시 여부 및 순서를 복원합니다." } }, "pt": { "stringUnit": { "state": "translated", "value": "Isto restaura os estilos, valores, visibilidade e ordem das métricas da barra de menus." } }, "ru": { "stringUnit": { "state": "translated", "value": "Будут восстановлены стили, значения, видимость и порядок показателей строки меню." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "这会还原菜单栏指标的样式、数值、显示状态和顺序。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "這會還原選單列指標的樣式、數值、顯示狀態和順序。" } } } },
    "settings.menuBar.resetAll.cancel": { "extractionState": "manual", "localizations": { "ar": { "stringUnit": { "state": "translated", "value": "إلغاء" } }, "de": { "stringUnit": { "state": "translated", "value": "Abbrechen" } }, "en": { "stringUnit": { "state": "translated", "value": "Cancel" } }, "es": { "stringUnit": { "state": "translated", "value": "Cancelar" } }, "fr": { "stringUnit": { "state": "translated", "value": "Annuler" } }, "ja": { "stringUnit": { "state": "translated", "value": "キャンセル" } }, "ko": { "stringUnit": { "state": "translated", "value": "취소" } }, "pt": { "stringUnit": { "state": "translated", "value": "Cancelar" } }, "ru": { "stringUnit": { "state": "translated", "value": "Отмена" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "取消" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "取消" } } } },
