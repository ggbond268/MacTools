        "pt": { "stringUnit": { "state": "translated", "value": "Pré-visualização ao vivo" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Предпросмотр" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "实时预览" } },
