        "en": { "stringUnit": { "state": "translated", "value": "Menu Bar Metrics Layout" } },
        "es": { "stringUnit": { "state": "translated", "value": "Diseño de métricas de la barra de menús" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Disposition des indicateurs de la barre des menus" } },
