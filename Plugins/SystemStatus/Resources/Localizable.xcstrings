      }
    },
    "settings.menuBar.builderDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "اختر ما يصل إلى قيمتين لكل مقياس. تظهر الأولى قبل الثانية أو فوقها. انقر على القيم أو اسحبها لتعيينها، واسحب المقاييس لإعادة ترتيبها." } },
        "de": { "stringUnit": { "state": "translated", "value": "Wähle pro Metrik bis zu zwei Werte. Der erste erscheint vor oder über dem zweiten. Klicke oder ziehe Werte zum Zuweisen; ziehe Metriken zum Neuordnen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Choose up to two values per metric. The first appears before or above the second. Click or drag values to assign them; drag metrics to reorder." } },
        "es": { "stringUnit": { "state": "translated", "value": "Elige hasta dos valores por métrica. El primero aparece antes o encima del segundo. Haz clic o arrastra valores para asignarlos; arrastra las métricas para reordenarlas." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisissez jusqu’à deux valeurs par mesure. La première apparaît avant ou au-dessus de la seconde. Cliquez sur les valeurs ou faites-les glisser pour les attribuer ; faites glisser les mesures pour les réordonner." } },
        "ja": { "stringUnit": { "state": "translated", "value": "指標ごとに最大2つの値を選択します。1つ目は2つ目の前または上に表示されます。値をクリックまたはドラッグして割り当て、指標をドラッグして並べ替えます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "지표마다 값을 최대 두 개 선택할 수 있습니다. 첫 번째 값은 두 번째 값보다 앞이나 위에 표시됩니다. 값을 클릭하거나 드래그해 지정하고, 지표를 드래그해 순서를 변경하십시오." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Escolha até dois valores por métrica. O primeiro aparece antes ou acima do segundo. Clique ou arraste valores para atribuí-los; arraste as métricas para reordená-las." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Выберите до двух значений для каждого показателя. Первое отображается перед вторым или над ним. Нажимайте или перетаскивайте значения для назначения; перетаскивайте показатели для изменения порядка." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "每个指标最多选择两个数值。第一个显示在第二个之前或上方。点击或拖拽数值进行分配，拖拽指标可调整顺序。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "每個指標最多選擇兩個數值。第一個會顯示在第二個之前或上方。點按或拖移數值以指派，拖移指標可調整順序。" } }
      }
    },
    "settings.menuBar.previewEmpty": {
